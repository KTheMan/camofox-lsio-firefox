+        handle, url, selected, fingerprint, parsed = _inspect(m, binding, policy, account_hint, provenance)
+        if fingerprint != binding['rowFingerprint']:
+            raise SurfaceError('prompt_changed')
+        m.switch_to_window(handle, focus=False)
