+
+    def test_rejects_special_file_after_nonblocking_open_without_reading(self):
+        fd = 46
+        info = SimpleNamespace(st_mode=stat.S_IFIFO | 0o600, st_size=0,
+                               st_uid=1234, st_nlink=1)
