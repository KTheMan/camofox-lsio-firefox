--- /dev/null
+++ b/lib/external-control.js
@@ -0,0 +1,13 @@
+import { assertBrowserAutomationAllowed } from './human-control.js';
+
+export function reserveExternalControl(controls, sessions, lease) {
+  // Revocation/relock must remain possible while a person owns a tab. Adding
+  // this reservation does not release or resume that person's existing lease.
+  if (!['bitwarden_lock', 'bitwarden_lock_failed'].includes(lease.reason)) {
+    assertBrowserAutomationAllowed(sessions);
+  }
+  if (controls.size && !controls.has(lease.id)) {
+    throw Object.assign(new Error('Another protected operation owns the browser'), { statusCode: 409 });
+  }
+  controls.set(lease.id, lease);
+}
diff --git a/lib/human-control.js b/lib/human-control.js
new file mode 100644
index 0000000..289ef45
--- /dev/null
+++ b/lib/human-control.js
@@ -0,0 +1,221 @@
+import { randomUUID } from 'node:crypto';
+
+const DEFAULT_TTL_SECONDS = 15 * 60;
+const MAX_TTL_SECONDS = 30 * 60;
+const PAUSED_STATES = new Set(['needs_human', 'human_control']);
+const REASONS = new Set(['captcha', 'login', 'mfa', 'manual']);
+
+function invalid(message, code = 'invalid_handoff') {
+  return Object.assign(new Error(message), { statusCode: 400, code });
+}
+
+export function handoffTtl(ttlSeconds = DEFAULT_TTL_SECONDS) {
+  if (!Number.isInteger(ttlSeconds) || ttlSeconds < 30 || ttlSeconds > MAX_TTL_SECONDS) {
+    throw invalid(`ttlSeconds must be an integer between 30 and ${MAX_TTL_SECONDS}`);
+  }
+  return ttlSeconds * 1000;
+}
+
+/** Expiry never silently grants automation control back to a possibly active human. */
+export function humanControlState(tabState, now = Date.now()) {
+  const lease = tabState?.humanControl;
+  if (!lease) return { state: 'automation', leaseId: null, expiresAt: null };
+  const state = PAUSED_STATES.has(lease.state) && now >= lease.expiresAt
+    ? 'expired'
+    : lease.state;
+  return {
+    state,
+    leaseId: lease.leaseId,
+    reason: lease.reason,
+    expiresAt: new Date(lease.expiresAt).toISOString(),
+    ...(state === 'expired' ? { action: 'Confirm human completion and resume, or renew the handoff.' } : {}),
+  };
+}
+
+/** Includes expired leases until their owner explicitly returns control. */
+export function hasHumanControl(tabState) {
+  return PAUSED_STATES.has(tabState?.humanControl?.state);
+}
+
+/** Only an unexpired lease pins a tab against resource/idle cleanup. */
+export function isHumanControlProtected(tabState, now = Date.now()) {
+  return hasHumanControl(tabState) && tabState.humanControl.expiresAt > now;
+}
+
+export function sessionHasHumanControl(session, now = Date.now()) {
+  for (const group of session?.tabGroups?.values() || []) {
+    for (const tabState of group.values()) {
+      if (isHumanControlProtected(tabState, now)) return true;
+    }
+  }
+  return false;
+}
+
+export function assertAutomationAllowed(tabState) {
+  if (hasHumanControl(tabState)) {
+    throw Object.assign(new Error('This tab is paused for human control. Confirm completion and resume before using browser tools.'), {
+      statusCode: 409,
+      code: 'human_control_active',
+    });
+  }
+}
+
+export function requestHumanControl(tabState, { reason = 'manual', ttlSeconds } = {}, now = Date.now()) {
+  if (!REASONS.has(reason)) throw invalid('reason must be captcha, login, mfa, or manual');
+  const ttlMs = handoffTtl(ttlSeconds);
+  // A retry must not create a replacement lease or invalidate the human's tab.
+  if (hasHumanControl(tabState)) return humanControlState(tabState, now);
+  tabState.humanControl = {
+    leaseId: randomUUID(),
+    reason,
+    state: 'needs_human',
+    expiresAt: now + ttlMs,
+  };
+  return humanControlState(tabState, now);
+}
+
+function requireLease(tabState, leaseId) {
+  const lease = tabState?.humanControl;
+  if (!lease || typeof leaseId !== 'string' || lease.leaseId !== leaseId) {
+    throw Object.assign(new Error('The handoff lease changed. Read handoff status before continuing.'), {
+      statusCode: 409,
+      code: 'handoff_lease_mismatch',
+    });
+  }
+  return lease;
+}
+
+export function markHumanControlFocused(tabState) {
+  if (hasHumanControl(tabState)) tabState.humanControl.state = 'human_control';
+}
+
+export function renewHumanControl(tabState, { leaseId, ttlSeconds } = {}, now = Date.now()) {
+  const ttlMs = handoffTtl(ttlSeconds);
+  const lease = requireLease(tabState, leaseId);
+  if (!hasHumanControl(tabState)) throw invalid('This handoff has already returned control.');
+  lease.expiresAt = now + ttlMs;
+  return humanControlState(tabState, now);
+}
+
+export function resumeHumanControl(tabState, { leaseId, humanConfirmed } = {}, now = Date.now()) {
+  const lease = requireLease(tabState, leaseId);
+  if (humanConfirmed !== true) throw invalid('humanConfirmed must be true after the human explicitly confirms completion.');
+  lease.state = 'ready_to_resume';
+  tabState._lastReaperCheck = now;
+  tabState._lastReaperToolCalls = tabState.toolCalls;
+  return humanControlState(tabState, now);
+}
+
+/** Only returns provider/state booleans; never frame text, token values or personal page content. */
+export async function detectHumanChallenge(page, timeoutMs = 2000) {
+  const unavailable = { detected: false, visibleChallenge: false, completionSignal: false, verification: 'unknown', signals: [], inspectionIncomplete: true };
+  let timer;
+  try {
+    return await Promise.race([
+      inspectHumanChallenge(page).catch(() => unavailable),
+      new Promise((resolve) => { timer = setTimeout(() => resolve(unavailable), timeoutMs); }),
+    ]);
+  } finally { clearTimeout(timer); }
+}
+
+async function inspectHumanChallenge(page) {
+  const signals = [];
+  let complete = false;
+  let inspectionFailed = false;
+  let visibleChallenge = false;
+  const frames = page.frames();
+  for (const frame of frames) {
+    const url = frame.url();
+    let provider;
+    if (/recaptcha/i.test(url)) provider = 'recaptcha';
+    else if (/hcaptcha/i.test(url)) provider = 'hcaptcha';
+    else if (/challenges\.cloudflare\.com|turnstile/i.test(url)) provider = 'turnstile';
+    else if (/arkose|funcaptcha/i.test(url)) provider = 'arkose';
+    else if (/perimeterx|px-captcha|datadome/i.test(url)) provider = 'challenge';
+    else continue;
+    let visible = false;
+    try {
+      const element = await frame.frameElement();
+      visible = await element.isVisible();
+      await element.dispose?.();
+      if (provider === 'recaptcha') {
+        const checked = await frame.locator('#recaptcha-anchor').getAttribute('aria-checked', { timeout: 500 }).catch(() => null);
+        if (checked === 'true') complete = true;
+      }
+    } catch {
+      inspectionFailed = true;
+    }
+    const challenge = visible && (provider !== 'recaptcha' || /bframe/i.test(url));
+    visibleChallenge ||= challenge;
+    signals.push({ provider, visible, challenge });
+  }
+  try {
+    complete ||= await page.evaluate(() => [...document.querySelectorAll(
+      'textarea[name="g-recaptcha-response"],textarea[name="h-captcha-response"],input[name="cf-turnstile-response"]'
+    )].some((element) => element.value.length > 0));
+  } catch {
+    inspectionFailed = true;
+  }
+  return {
+    detected: signals.length > 0,
+    visibleChallenge,
+    completionSignal: complete,
+    verification: complete && !visibleChallenge ? 'completion_signal' : signals.length ? 'human_confirmation_required' : 'unknown',
+    signals,
+    ...(inspectionFailed ? { inspectionIncomplete: true } : {}),
+  };
+}
+
+function allControlledTabs(sessions) {
+  const controlled = [];
+  for (const session of sessions.values()) {
+    for (const group of session.tabGroups.values()) {
+      for (const [tabId, tabState] of group) {
+        if (hasHumanControl(tabState)) controlled.push({ tabId, tabState });
+      }
+    }
+  }
+  return controlled;
+}
+
+export function assertBrowserAutomationAllowed(sessions) {
+  const controlled = allControlledTabs(sessions);
+  if (controlled.length) assertAutomationAllowed(controlled[0].tabState);
+}
+
+/**
+ * Install before all browser routes. A shared desktop has one human focus, so
+ * another context must not create/focus windows or capture the human's login.
+ * Authentication must run before this middleware. Queued actions also need
+ * assertAutomationAllowed() after acquiring the core tab lock.
+ */
+export function humanControlMiddleware(sessions) {
+  return (req, res, next) => {
+    // Express accepts case variants and trailing slashes by default. The pause
+    // boundary must cover those aliases and future routes without an allowlist update.
+    let pathname;
+    try {
+      pathname = decodeURIComponent(req.path).toLowerCase().replace(/\/+$/, '') || '/';
+    } catch {
+      return res.status(400).json({ error: 'Invalid request path' });
+    }
+    const method = req.method.toUpperCase();
+    const safe = method === 'GET' && (pathname === '/health' || pathname === '/tabs' || /^\/bitwarden\/operations\/[^/]+$/.test(pathname));
+    const management = ((method === 'GET' || method === 'POST') && /^\/tabs\/[^/]+\/handoff$/.test(pathname))
+      || (method === 'POST' && /^\/tabs\/[^/]+\/(?:handoff\/(?:renew|resume)|focus)$/.test(pathname))
+      || (method === 'POST' && (pathname === '/bitwarden/cancel' || pathname === '/bitwarden/lock'));
+    if (safe || management) return next();
+    const controlled = allControlledTabs(sessions);
+    if (!controlled.length) return next();
+    return res.status(409).json({
+      error: 'The shared browser is paused for human control. Confirm completion and resume the handoff before using browser tools.',
+      code: 'human_control_active',
+    });
+  };
+}
+
+export function assertNoOtherHumanControl(sessions, targetTab) {
+  if (allControlledTabs(sessions).some(({ tabState }) => tabState !== targetTab)) {
+    throw Object.assign(new Error('Another tab is already under human control.'), { statusCode: 409, code: 'human_control_active' });
+  }
+}
