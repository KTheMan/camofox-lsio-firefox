+
+const context = { userId: 'stable-owner', sessionKey: 'task-one' };
+
+describe('human-handoff and vault MCP contracts', () => {
+  test('handoff preserves current identity and lease confirmation without a replacement tab', () => {
+    expect(buildRequest('camofox_request_handoff', { tabId: 'one', reason: 'captcha', ttlSeconds: 900 }, context)).toMatchObject({
+      method: 'POST', path: '/tabs/one/handoff', body: { userId: 'stable-owner', reason: 'captcha', ttlSeconds: 900 },
