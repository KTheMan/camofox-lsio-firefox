+        self.context = None
+        self.current_handle = None
+        self.unavailable_handles = set()
+
+    def set_context(self, context):
+        self.context = context
+
+    def switch_to_window(self, handle, focus=False):
+        if handle in self.unavailable_handles:
+            raise RuntimeError("closed handle")
+        self.current_handle = handle
+
+    def switch_to_frame(self):
+        self.calls.append(("reset_frame", self.current_handle))
+
+    def execute_script(self, script, script_args=None):
+        self.calls.append(("execute_script", script, list(script_args or []), self.context, self.current_handle))
+        if script == _POPUP_JS:
+            return {"ok": True, "attached": 1}
+        if script == _RESOLVE_JS:
+            return "moz-extension://" + EXT + "/popup/index.html?uilocation=popout&singleActionPopout=vault_Fido2Popout_8f1f3b7d-61ec-4e64-a4a1-2dab403f00df#/fido2?sessionId=8f1f3b7d-61ec-4e64-a4a1-2dab403f00df&senderTabId=7&senderUrl=https%3A%2F%2Frp.example.test%2Flogin"
+        if script == _OWNER_STATUS_JS:
+            return {"ok": True, "events": 1, "windows": 1, "captures": [{"bcId": "9", "browserId": 7, "innerWindowId": 14}], "capturedTotal": 1}
+        if script == _CLOSE_JS:
+            return True
+        raise AssertionError("unexpected native script")
+
+    def execute_async_script(self, script, script_args=None):
+        self.calls.append(("execute_async_script", script, list(script_args or []), self.context, self.current_handle))
+        if script != _TARGET_JS:
+            raise AssertionError("unexpected native async script")
+        return {"ok": True, "value": {"sent": True}}
+
+
+def deadline(ms=60_000):
+    return int(time.time() * 1000) + ms
+
+
+class PopupProvenanceTests(unittest.TestCase):
+    def test_rejects_invalid_or_unbounded_deadlines(self):
