+def popup_url(*, extension=EXTENSION, session=SESSION, route="/fido2", outer=None,
+              fragment_fields=None):
+    outer_values = outer or {
+        "uilocation": "popout",
+        "singleActionPopout": f"vault_Fido2Popout_{session}",
+    }
+    fields = fragment_fields or {
+        "sessionId": session,
+        "senderTabId": "7",
+        "senderUrl": EXPECTED_URL,
+        "fallbackSupported": "true",
+    }
+    return (f"moz-extension://{extension}/popup/index.html?{urlencode(outer_values)}"
+            f"#{route}?{urlencode(fields)}")
