+++ b/tests/unit/bitwardenWindow.test.js
@@ -0,0 +1,185 @@
+import { describe, test, expect, jest } from '@jest/globals';
+import { EventEmitter } from 'node:events';
+import { browserWindowDriver, runDriver } from '../../plugins/bitwarden-unlock/runtime.js';
+
+describe('windowless headed browser initialization', () => {
+  test('holds a leased bootstrap page for the driver and closes it afterwards', async () => {
+    const session = { marker: 'internal-only' }, bootstrap = { page: { bringToFront: async () => {} }, lease: {} }, calls = [];
+    const ctx = {
+      ensureBrowser: async () => ({ contexts: () => [] }),
+      getSession: jest.fn(async () => session),
+      createLeasedPage: async (value) => { expect(value).toBe(session); calls.push('open'); return bootstrap; },
+      closeLeasedPage: async (...args) => { expect(args).toEqual([session, bootstrap.page, bootstrap.lease]); calls.push('close'); },
+    };
+    const execute = browserWindowDriver(ctx, async () => { calls.push('driver'); return { ok: true, state: 'login_start' }; });
+    expect(await execute({ action: 'status' })).toEqual({ ok: true, state: 'login_start' });
+    expect(calls).toEqual(['open', 'driver', 'close']);
+    expect(ctx.getSession).toHaveBeenCalledWith('__bitwarden_broker__');
+  });
+  test('does not create or close tabs when an existing page already initializes Marionette', async () => {
+    const ctx = {
+      ensureBrowser: async () => ({ contexts: () => [{ pages: () => [{
+        isClosed: () => false, url: () => 'about:blank', bringToFront: async () => {},
+      }] }] }),
+      getSession: jest.fn(), createLeasedPage: jest.fn(), closeLeasedPage: jest.fn(),
+    };
+    const execute = browserWindowDriver(ctx, async () => ({ ok: true, state: 'locked' }));
+    await execute({ action: 'status' });
+    expect(ctx.getSession).not.toHaveBeenCalled();
+    expect(ctx.createLeasedPage).not.toHaveBeenCalled();
+    expect(ctx.closeLeasedPage).not.toHaveBeenCalled();
+  });
+  test('brings a normal page forward and skips extension popup pages', async () => {
+    const calls = [], extension = {
+      isClosed: () => false, url: () => 'moz-extension://addon/popup/index.html',
+      bringToFront: jest.fn(async () => calls.push('extension-front')),
+    }, normal = {
+      isClosed: () => false, url: () => 'https://example.test/',
+      bringToFront: jest.fn(async () => calls.push('normal-front')),
+    };
+    const ctx = {
+      ensureBrowser: async () => ({ contexts: () => [{ pages: () => [extension, normal] }] }),
+      getSession: jest.fn(), createLeasedPage: jest.fn(), closeLeasedPage: jest.fn(),
+    };
+    const execute = browserWindowDriver(ctx, async () => { calls.push('driver'); return { ok: true, state: 'locked' }; });
+    await execute({ action: 'status' });
+    expect(calls).toEqual(['normal-front', 'driver']);
+    expect(ctx.createLeasedPage).not.toHaveBeenCalled();
+  });
+  test('holds a bootstrap across 2FA and reuses it for status until terminal state', async () => {
+    const session = {}, page = {
+      isClosed: () => false, url: () => 'about:blank', bringToFront: jest.fn(async () => {}),
+    }, bootstrap = { page, lease: {} }, calls = [];
+    const browser = { contexts: () => [] };
+    const ctx = {
+      ensureBrowser: async () => browser,
+      getSession: jest.fn(async () => session),
+      createLeasedPage: jest.fn(async () => { calls.push('open'); return bootstrap; }),
+      closeLeasedPage: jest.fn(async (...args) => { expect(args).toEqual([session, page, bootstrap.lease]); calls.push('close'); }),
+    };
+    const outcomes = [
+      { ok: false, state: 'two_factor_required' },
+      { ok: false, state: 'two_factor_required' },
+      { ok: true, state: 'unlocked' },
+    ];
+    const execute = browserWindowDriver(ctx, async () => { calls.push('driver'); return outcomes.shift(); });
+    expect((await execute({ action: 'unlock' })).state).toBe('two_factor_required');
+    expect(calls).toEqual(['open', 'driver']);
+    expect((await execute({ action: 'status' })).state).toBe('two_factor_required');
+    expect(calls).toEqual(['open', 'driver', 'driver']);
+    expect((await execute({ action: 'status' })).state).toBe('unlocked');
+    expect(calls).toEqual(['open', 'driver', 'driver', 'driver', 'close']);
+    expect(ctx.createLeasedPage).toHaveBeenCalledTimes(1);
+  });
+  test('human 2FA status does not refocus, create, close, or discard the held bootstrap', async () => {
+    const session = {}, page = { bringToFront: jest.fn(async () => {}) }, bootstrap = { page, lease: {} };
+    const browser = { contexts: () => [] };
+    const ctx = {
+      ensureBrowser: async () => browser, getSession: jest.fn(async () => session),
+      createLeasedPage: jest.fn(async () => bootstrap), closeLeasedPage: jest.fn(async () => {}),
+    };
+    const driver = jest.fn()
+      .mockResolvedValueOnce({ ok: false, state: 'two_factor_required' })
+      .mockResolvedValueOnce({ ok: false, state: 'unavailable', errorCode: 'driver_timeout' });
+    const execute = browserWindowDriver(ctx, driver);
+    await execute({ action: 'unlock' });
+    expect(page.bringToFront).toHaveBeenCalledTimes(1);
+    const status = await execute({ action: 'status' }, { keepHumanUI: true });
+    expect(status.state).toBe('unavailable');
+    expect(driver).toHaveBeenLastCalledWith({ action: 'status' }, { keepHumanUI: true });
+    expect(page.bringToFront).toHaveBeenCalledTimes(1);
+    expect(ctx.createLeasedPage).toHaveBeenCalledTimes(1);
+    expect(ctx.closeLeasedPage).not.toHaveBeenCalled();
+  });
+  test('human 2FA status with no held bootstrap does not focus a regular page or create one', async () => {
+    const page = { isClosed: () => false, url: () => 'https://example.test/', bringToFront: jest.fn() };
+    const ctx = {
+      ensureBrowser: async () => ({ contexts: () => [{ pages: () => [page] }] }),
+      getSession: jest.fn(), createLeasedPage: jest.fn(), closeLeasedPage: jest.fn(),
+    };
+    const driver = jest.fn(async () => ({ ok: false, state: 'two_factor_required' }));
+    await browserWindowDriver(ctx, driver)({ action: 'status' }, { keepHumanUI: true });
+    expect(page.bringToFront).not.toHaveBeenCalled();
+    expect(ctx.createLeasedPage).not.toHaveBeenCalled();
+    expect(driver).toHaveBeenCalledWith({ action: 'status' }, { keepHumanUI: true });
+  });
+  test('human 2FA status exception keeps the held bootstrap for a later lock', async () => {
+    const session = {}, page = { bringToFront: jest.fn(async () => {}) }, bootstrap = { page, lease: {} };
+    const browser = { contexts: () => [] };
+    const ctx = {
+      ensureBrowser: async () => browser, getSession: async () => session,
+      createLeasedPage: jest.fn(async () => bootstrap), closeLeasedPage: jest.fn(async () => {}),
+    };
+    const driver = jest.fn()
+      .mockResolvedValueOnce({ ok: false, state: 'two_factor_required' })
+      .mockRejectedValueOnce(new Error('Marionette session unavailable'))
+      .mockResolvedValueOnce({ ok: true, state: 'locked' });
