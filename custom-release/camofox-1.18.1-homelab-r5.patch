--- /dev/null
+++ b/plugins/access-gate/index.js
@@ -0,0 +1,16 @@
+import { startAccessGate } from '../../lib/access-jwt.js';
+
+export function register(_app, ctx) {
+  if (!ctx.config.accessGateEnabled) return;
+  const server = startAccessGate({
+    issuer: ctx.config.accessIssuer,
+    audience: ctx.config.accessAudience,
+    jwksFile: ctx.config.accessJwksFile,
+    host: '0.0.0.0', port: 9380,
+  });
+  server.on('error', () => {
+    // Do not leave a release running with an unavailable configured auth gate.
+    ctx.log('error', 'Access verification listener unavailable');
+  });
+  ctx.events.once('server:shutdown', () => server.close());
+}
diff --git a/plugins/bitwarden-unlock/README.md b/plugins/bitwarden-unlock/README.md
new file mode 100644
index 0000000..f393046
--- /dev/null
+++ b/plugins/bitwarden-unlock/README.md
@@ -0,0 +1,101 @@
+# Bitwarden extension broker
+
+The extension is **browser-wide**. Playwright user IDs isolate website contexts;
+they do not create independent Bitwarden extension accounts. Only one unlock
+operation may own the extension at a time. A browser restart revokes all
+operations. Status/lock use Marionette and the exact Bitwarden addon ID, not
+Playwright extension-page navigation or the first profile-storage directory.
+
+Unlock HTTP accepts no passwords, email, debug inventories, or raw UI text. An
+authenticated `POST /bitwarden/unlock` with `{userId, ttlSeconds?}` returns an
+opaque `operationId`, a `browserInstance`, and a 60-second delivery deadline.
+The operation is for this browser generation only. Poll
+`GET /bitwarden/operations/:operationId?userId=...`; cancel with
+`POST /bitwarden/cancel` or lock globally with `POST /bitwarden/lock`.
+
+An owner-controlled secret provider delivers `{email, masterPassword}` as JSON
+on stdin to `broker-unlock.py --operation-id ID --browser-instance INSTANCE`.
+Run this inside the intended container as UID 911. The helper validates the
+owner-only Unix socket and parent directory. It sends to the socket directly;
+the password never enters an HTTP/MCP argument, argv, environment, result, or
+temporary credential file. The driver receives it only on stdin and returns
+allowlisted typed states. JavaScript/Python strings are not guaranteed to be
+zeroed in memory; references are dropped promptly and secret-bearing stderr is
+discarded.
+
+The deployment broker should use a fixed container name/ID, fixed UID, fixed
+helper path, and a narrow owner authorization policy. Do not accept arbitrary
+Docker commands or destinations from an agent. The two opaque IDs are routing
+data, not permission to fetch a master password. The OS-protected local broker
+socket is the delivery authority. A dummy provider is sufficient to verify this
+contract; do not retrieve real credentials as a test.
+
+The existing collector's readiness/find/TOTP interface does **not** provide
+this secret-delivery operation. Keep that wrapper unchanged. This candidate
+includes a separate host-side `vaultwarden-deliver.py` adapter and dedicated
+systemd unit. The unit references the same existing encrypted credential source
+as `collector-vault-unlock.service`, verified only through metadata. Before
+reading systemd's decrypted credential, the adapter pins the container image/ID
+and checks that the exact operation/browser generation is ready through the
+owner-only socket. It then delivers directly to helper stdin. The release includes the host installer separately from the browser image.
+Credential-free acceptance does not invoke the real provider.
+
+Owner installation must put these host scripts under root-owned
+`/opt/camofox-extension-broker`, install the unit/tmpfiles configuration, and
+create `/etc/camofox-extension-broker/config.json` with exactly `containerName`,
+`expectedImageId` (full immutable sha256 image ID), and the intended account's
+`email`. The config is non-secret but must be root/owner-controlled and not
+group/world-writable. The delivery service runs as `camofox`.
+`request-unlock.py` writes only the operation and browser UUIDs to an exclusive
+owner-only RAM request file and starts its exact unit instance. The installed owner-scoped policy authorizes only canonical UUIDv4 instances
+of this exact credential service; it grants no wildcard service or sudo permission. No existing master secret is
+discovered, exported, or silently reused in tests. Real credential delivery must be exercised only for an authorized consuming login;
+it is not part of disposable-fixture acceptance.
+
+An unlock expires after 30–900 seconds (default 300). The broker attempts relock
+and verifies a locked/logged-out state. It returns `lock_failed` if the pinned
+UI cannot confirm the lock; never treat that state as success. A 2FA challenge
+returns `two_factor_required`, starts the same bounded relock window, and must
+be completed manually in the existing visible extension session. Enterprise policy installs the pinned signed package; the helper never installs
+or reinstalls it. Extension account persistence across browser restarts is
+intentionally not claimed. Website storage persistence is a separate feature.
+
+The actual toolbar is required. Master-password lock closes that toolbar before
+waiting for the extension process reload; one later open verifies locked state.
+PIN/biometric no-reload modes fail closed in this release. After reload, start a
+new site ceremony from a fresh ordinary document; do not reload a pending Fido
+prompt.
+
+## Native passkey sign-in (R4)
+
+The user-selected policy is default allow with an initially empty administrator
+blacklist. `POST /tabs/:tabId/passkey/approve` accepts exactly `{userId, operationId,
+accountHint?}` and requires this task's owned HTTPS tab and active unlocked broker
+lease. Unlock before starting the website's passkey request so the native controller
+is already armed. The signed extension's normal GET prompt performs all signing;
+there is no key export, signing SDK, registration approval, or virtual authenticator.
+
+The fixed policy path is `CAMOFOX_PASSKEY_POLICY_FILE` (production
+`/run/camofox-passkeys/blacklist.json`). Mount its administrator-owned directory
+read-only, allowing atomic host replacements. Missing or malformed policy fails
+closed. The exact schema is:
+
+```json
+{"version":1,"blockedOrigins":[],"blockedRpIds":[],"blockedAccounts":[]}
+```
+
+Origins are exact bare HTTPS origins. RP blocks include descendant domains.
+Account blocks compare whitespace-normalized, case-insensitive visible usernames,
+not vault item titles or cryptographic user handles. Unknown fields, wildcards,
+symlinks and insecure file permissions are rejected. The HTTP/MCP interface cannot
+edit this policy. Ambiguous eligible accounts need an exact visible `accountHint`.
+
+One attempted approval consumes the native session before a permit is sent.
+`approval_sent` confirms delivery of the normal extension click; verify website
+login separately, then lock and confirm a locked state. `approval_uncertain` and
+`verification_required` preserve browser protection until verified relock. Manually complete
+verification if needed, verify the website, then explicitly relock. Never retry an uncertain signing attempt. Human CAPTCHA/login handoff
+remains independent. Disposable-fixture evidence must match the immutable release
+image before promotion; a source test or diagnostic overlay is not acceptance.
+
+Equivalent FIDO URL encodings pass only when every decoded field and its presence match exactly, with valid UTF-8 and no duplicate or unknown fields.
diff --git a/plugins/bitwarden-unlock/approval_policy.py b/plugins/bitwarden-unlock/approval_policy.py
new file mode 100644
index 0000000..0436b37
--- /dev/null
+++ b/plugins/bitwarden-unlock/approval_policy.py
@@ -0,0 +1,219 @@
+"""Strict host-configured denylist for native Bitwarden passkey approval.
+
+This module only validates policy and compares already-bound observations. It
+does not find prompts, choose vault rows, or click approval controls. The host
+must load the raw JSON bytes so duplicate object keys remain detectable.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import json
+import os
+import stat
+import re
+from urllib.parse import urlsplit
+
+
+DEFAULT_POLICY_JSON = b'{"version":1,"blockedOrigins":[],"blockedRpIds":[],"blockedAccounts":[]}\n'
+MAX_POLICY_BYTES = 64 * 1024
+MAX_ENTRIES_PER_LIST = 256
+_DNS_LABEL = re.compile(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\Z")
+
+
+class PolicyError(ValueError):
+    """Invalid policy or untrustworthy observation; callers must fail closed."""
+
+
+@dataclass(frozen=True)
+class ApprovalPolicy:
+    blocked_origins: frozenset[str]
+    blocked_rp_ids: frozenset[str]
+    blocked_accounts: frozenset[str]
+
+
+def _unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise PolicyError("invalid_approval_policy")
+        result[key] = value
+    return result
+
+
+def _reject_constant(_value):
+    raise PolicyError("invalid_approval_policy")
+
+
+def _dns_name(value: object) -> bool:
+    if not isinstance(value, str) or not value or len(value) > 253 or not value.isascii():
+        return False
+    if value != value.lower() or value.endswith("."):
+        return False
+    labels = value.split(".")
+    return len(labels) >= 2 and all(_DNS_LABEL.fullmatch(label) for label in labels)
+
+
+def _origin(value: object) -> tuple[str, str] | None:
+    """Accept one canonical bare HTTPS DNS origin, preserving nondefault ports."""
+    if not isinstance(value, str) or not value or len(value) > 512:
+        return None
+    if any(ch.isspace() or ord(ch) < 0x20 for ch in value) or "\\" in value or "%" in value:
+        return None
+    try:
+        parsed = urlsplit(value)
+        host = parsed.hostname
+        port = parsed.port
+    except (ValueError, UnicodeError):
+        return None
+    if parsed.scheme != "https" or not parsed.netloc or not host:
+        return None
+    if parsed.username is not None or parsed.password is not None or "@" in parsed.netloc:
+        return None
+    if parsed.path or parsed.query or parsed.fragment or not _dns_name(host):
+        return None
+    if port is not None and (port < 1 or port > 65535 or port == 443):
+        return None
+    canonical_authority = host if port is None else f"{host}:{port}"
+    if parsed.netloc != canonical_authority or value != f"https://{canonical_authority}":
+        return None
+    return value, host
+
+
+def _rp_id(value: object) -> str | None:
+    return value if _dns_name(value) else None
+
+
+def _account(value: object) -> str | None:
+    if not isinstance(value, str) or not value or len(value) > 512:
+        return None
+    if any((ord(ch) < 0x20 and not ch.isspace()) or ord(ch) == 0x7f for ch in value) or "*" in value:
+        return None
+    normalized = " ".join(value.split()).casefold()
+    return normalized or None
+
+
+def load_policy(raw: bytes | str) -> ApprovalPolicy:
+    """Parse a bounded raw JSON policy, rejecting duplicate/unknown fields.
+
+    Missing policy is intentionally not treated as empty. The caller must
+    explicitly load ``DEFAULT_POLICY_JSON`` for the default-allow configuration.
+    """
+    if isinstance(raw, bytes):
+        if len(raw) > MAX_POLICY_BYTES:
+            raise PolicyError("invalid_approval_policy")
+        try:
+            raw = raw.decode("utf-8", "strict")
+        except UnicodeError as exc:
+            raise PolicyError("invalid_approval_policy") from exc
+    elif isinstance(raw, str):
+        try:
+            if len(raw.encode("utf-8", "strict")) > MAX_POLICY_BYTES:
+                raise PolicyError("invalid_approval_policy")
+        except UnicodeError as exc:
+            raise PolicyError("invalid_approval_policy") from exc
+    else:
+        raise PolicyError("invalid_approval_policy")
+    try:
+        document = json.loads(raw, object_pairs_hook=_unique_object, parse_constant=_reject_constant)
+    except (ValueError, UnicodeError, RecursionError) as exc:
+        raise PolicyError("invalid_approval_policy") from exc
+    if not isinstance(document, dict) or set(document) != {"version", "blockedOrigins", "blockedRpIds", "blockedAccounts"}:
+        raise PolicyError("invalid_approval_policy")
+    if type(document["version"]) is not int or document["version"] != 1:
+        raise PolicyError("invalid_approval_policy")
+
+    lists = {}
+    for name in ("blockedOrigins", "blockedRpIds", "blockedAccounts"):
+        entries = document[name]
+        if not isinstance(entries, list) or len(entries) > MAX_ENTRIES_PER_LIST:
+            raise PolicyError("invalid_approval_policy")
+        normalized = []
+        for entry in entries:
+            if name == "blockedOrigins":
+                parsed = _origin(entry)
+                value = parsed[0] if parsed else None
+            elif name == "blockedRpIds":
+                value = _rp_id(entry)
+            else:
+                value = _account(entry)
+            if value is None:
+                raise PolicyError("invalid_approval_policy")
+            normalized.append(value)
+        if len(set(normalized)) != len(normalized):
+            raise PolicyError("invalid_approval_policy")
+        lists[name] = frozenset(normalized)
+    return ApprovalPolicy(lists["blockedOrigins"], lists["blockedRpIds"], lists["blockedAccounts"])
+
+
+def load_policy_file(path: str | os.PathLike) -> ApprovalPolicy:
+    """Load a host-owned policy file without following its final path component.
+
+    The caller must supply a fixed, host-configured path; it must not come from
+    an MCP/model argument. Missing, unreadable, unsafe, or malformed files fail
+    closed. The explicit empty default is available as ``DEFAULT_POLICY_JSON``.
+    """
+    fd = None
+    try:
+        flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | os.O_NOFOLLOW | getattr(os, "O_NONBLOCK", 0)
+        fd = os.open(path, flags)
+        info = os.fstat(fd)
+        if (not stat.S_ISREG(info.st_mode) or info.st_size > MAX_POLICY_BYTES
+                or info.st_uid not in {0, os.getuid()} or info.st_mode & 0o022
+                or info.st_nlink != 1):
+            raise PolicyError("invalid_approval_policy_file")
+        chunks = []
+        remaining = MAX_POLICY_BYTES + 1
+        while remaining:
+            chunk = os.read(fd, min(8192, remaining))
+            if not chunk:
+                break
+            chunks.append(chunk)
+            remaining -= len(chunk)
+        raw = b"".join(chunks)
+        if len(raw) > MAX_POLICY_BYTES:
+            raise PolicyError("invalid_approval_policy_file")
+    except PolicyError:
+        raise
+    except (OSError, TypeError, ValueError, AttributeError) as exc:
+        raise PolicyError("invalid_approval_policy_file") from exc
+    finally:
+        if fd is not None:
+            os.close(fd)
+    return load_policy(raw)
+
+
+def is_blocked(policy: ApprovalPolicy, observation: object) -> bool:
+    """Return whether any exact deny criterion matches a trusted observation.
+
+    A blocked RP ID is treated as a domain block on the trusted origin host:
+    the host itself or any descendant host is blocked, regardless of which
+    credential row supplied incidental RP metadata.
+
+    ``observation`` contains only values obtained after independent prompt,
+    sender-tab/frame, and account/row binding. Invalid or incomplete site binding
+    raises PolicyError so the caller can fail closed; an empty valid denylist
+    returns False (default allow).
+    """
+    if not isinstance(policy, ApprovalPolicy) or not isinstance(observation, dict):
+        raise PolicyError("invalid_approval_context")
+    if set(observation) - {"origin", "rpId", "account"} or not {"origin", "rpId"}.issubset(observation):
+        raise PolicyError("invalid_approval_context")
+    parsed_origin = _origin(observation["origin"])
+    rp_id = _rp_id(observation["rpId"])
+    if parsed_origin is None or rp_id is None:
+        raise PolicyError("invalid_approval_context")
+    host = parsed_origin[1]
+    if host != rp_id and not host.endswith("." + rp_id):
+        raise PolicyError("invalid_approval_context")
+    account = None
+    if "account" in observation:
+        account = _account(observation["account"])
+        if account is None:
+            raise PolicyError("invalid_approval_context")
+    if policy.blocked_accounts and account is None:
+        raise PolicyError("invalid_approval_context")
+    return (parsed_origin[0] in policy.blocked_origins
+            or any(host == blocked_rp or host.endswith("." + blocked_rp)
+                   for blocked_rp in policy.blocked_rp_ids)
+            or (account is not None and account in policy.blocked_accounts))
diff --git a/plugins/bitwarden-unlock/broker-unlock.py b/plugins/bitwarden-unlock/broker-unlock.py
new file mode 100644
index 0000000..3317e7a
--- /dev/null
+++ b/plugins/bitwarden-unlock/broker-unlock.py
@@ -0,0 +1,80 @@
+#!/usr/bin/env python3
+"""Protected secret-provider adapter. Input JSON on stdin; typed result out.
+
+Run as the container's browser UID. Neither a provider command nor any password
+is accepted in argv. The HTTP caller gives an opaque operationId and browser
+instance; the owner-controlled provider supplies email/masterPassword privately.
+"""
+import argparse
+import json
+import os
+import socket
+import stat
+import sys
+import uuid
+
+DEFAULT_SOCKET = "/config/.camofox/bitwarden-broker/unlock.sock"
+MAX_MESSAGE = 16384
+STATES = {"awaiting_secret", "unlocking", "unlocked", "two_factor_required", "failed", "cancelled", "expired", "locked", "lock_failed"}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--operation-id", required=True)
+    parser.add_argument("--browser-instance", required=True)
+    parser.add_argument("--socket", default=DEFAULT_SOCKET)
+    parser.add_argument("--check", action="store_true", help="Check destination readiness without reading stdin or a credential.")
+    args = parser.parse_args()
+    try:
+        uuid.UUID(args.operation_id)
+        uuid.UUID(args.browser_instance)
+        info = os.lstat(args.socket)
+        parent = os.lstat(os.path.dirname(args.socket))
+        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) & 0o077:
+            raise ValueError()
+        if not stat.S_ISDIR(parent.st_mode) or parent.st_uid != os.getuid() or stat.S_IMODE(parent.st_mode) & 0o077:
+            raise ValueError()
+        if args.check:
+            value = {"action": "check"}
+        else:
+            raw = sys.stdin.read(MAX_MESSAGE + 1)
+            if len(raw.encode("utf-8")) > MAX_MESSAGE:
+                raise ValueError()
+            value = json.loads(raw)
+            if not isinstance(value, dict) or set(value) - {"email", "masterPassword"} or not isinstance(value.get("masterPassword"), str) or not value["masterPassword"]:
+                raise ValueError()
+        value.update(operationId=args.operation_id, browserInstance=args.browser_instance)
+        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
+            client.settimeout(65)
+            client.connect(args.socket)
+            client.sendall(json.dumps(value).encode("utf-8") + b"\n")
+            value.clear()
+            raw = ""
+            reply = b""
+            while b"\n" not in reply:
+                chunk = client.recv(4096)
+                if not chunk:
+                    break
+                reply += chunk
+                if len(reply) > MAX_MESSAGE:
+                    raise ValueError()
+        response = json.loads(reply)
+        # Do not echo arbitrary messages from an incorrectly configured socket.
+        output = {"ok": response.get("ok") is True}
+        if response.get("state") in STATES:
+            output["state"] = response["state"]
+        if response.get("operationId") == args.operation_id:
+            output["operationId"] = args.operation_id
+        if response.get("browserInstance") == args.browser_instance:
+            output["browserInstance"] = args.browser_instance
+        if not output["ok"]:
+            output["errorCode"] = "unlock_not_completed"
+        print(json.dumps(output), flush=True)
+        return 0 if output["ok"] else 1
+    except Exception:
+        print(json.dumps({"ok": False, "errorCode": "protected_delivery_failed"}), flush=True)
+        return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
