+  }));
+  /**
+   * @openapi
+   * /bitwarden/lock:
+   *   post:
+   *     tags: [Browser]
+   *     summary: Lock extension and revoke pending browser-wide unlock operations.
+   *     requestBody:
+   *       required: true
+   *       content:
+   *         application/json:
+   *           schema:
+   *             type: object
+   *             required: [userId]
+   *             properties:
+   *               userId: { type: string }
+   *     responses:
