+from contextlib import nullcontext
+from unittest.mock import patch
+
+spec = importlib.util.spec_from_file_location("bitwarden_driver", pathlib.Path(__file__).with_name("driver.py"))
+driver = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(driver)
+
+
+class PolicyBrowser:
+    def __init__(self, policy=None):
+        self.policy = policy
+        self.installs = []
+
+    def using_context(self, _):
+        return nullcontext()
+
+    def execute_async_script(self, script, script_args=None):
+        return self.policy
+
+    def _send_message(self, command, body, key=None):
+        self.installs.append((command, body))
+        raise AssertionError("The driver must never install or reinstall an addon")
+
+
+class Clock:
+    def __init__(self):
+        self.now = 0
+    def monotonic(self):
+        return self.now
+    def sleep(self, seconds):
+        self.now += seconds
+
+
+class DriverTests(unittest.TestCase):
+    def test_installed_addon_is_identified_by_id_without_reinstall_churn(self):
+        browser = PolicyBrowser({"id": driver.ADDON_ID, "uuid": "exact-addon-uuid", "version": driver.ADDON_VERSION})
+        browser.policy.update(active=True, signedState=2)
+        with patch.object(driver, "addon_package_matches", return_value=True):
+            self.assertEqual(driver.ensure_extension(browser), "exact-addon-uuid")
+        self.assertEqual(browser.installs, [])
+
+    def test_fresh_profile_waits_for_policy_arrival_and_activation_without_installing(self):
+        browser = PolicyBrowser(); clock = Clock()
+        ready = {"id": driver.ADDON_ID, "uuid": "exact-addon-uuid", "version": driver.ADDON_VERSION,
+                 "active": True, "signedState": 2}
+        with patch.object(driver, "addon_package_matches", return_value=True), \
+             patch.object(driver, "extension_policy", side_effect=[None, None, {**ready,"active":False}, ready]), \
+             patch.object(driver.time, "monotonic", clock.monotonic), \
+             patch.object(driver.time, "sleep", clock.sleep):
+            self.assertEqual(driver.ensure_extension(browser), "exact-addon-uuid")
+        self.assertEqual(browser.installs, [])
+        self.assertEqual(clock.now, .75)
+
+    def test_unavailable_policy_has_bounded_typed_refusal_and_never_installs(self):
+        class Unavailable(PolicyBrowser):
+            def __init__(self, **_kwargs):
+                super().__init__()
+                self.timeout = type("Timeout", (), {})()
+            def start_session(self, **_kwargs):
+                pass
+            def delete_session(self):
+                pass
+        browser = Unavailable(); clock = Clock()
+        with patch.object(driver, "addon_package_matches", return_value=True), \
+             patch.object(driver.time, "monotonic", clock.monotonic), \
+             patch.object(driver.time, "sleep", clock.sleep):
+            response = driver.run({"action":"status"}, marionette_factory=lambda **kw:browser)
+        self.assertEqual(response, {"ok":False,"state":"unavailable","errorCode":"extension_unavailable"})
+        self.assertEqual(browser.installs, [])
+        self.assertEqual(clock.now, 10)
+
+    def test_wrong_extension_policy_is_not_accepted_or_reinstalled(self):
+        browser = PolicyBrowser({"id": "unrelated-addon", "uuid": "wrong"})
+        with patch.object(driver, "addon_package_matches", return_value=True):
+            with self.assertRaises(driver.DriverError):
+                driver.ensure_extension(browser)
+        self.assertEqual(browser.installs, [])
+
+    def test_candidate_pins_official_signed_same_version_and_rejects_mismatches(self):
+        self.assertIn("2026.7.0", driver.ADDON_XPI)
+        self.assertEqual(driver.ADDON_SHA256,
+                         "11836eb9d2abc9914bb337b57e20c5a09cf44f24fa572f7e886384fd350a5112")
+        good = {"id":driver.ADDON_ID,"uuid":"exact-addon-uuid","version":driver.ADDON_VERSION,
+                "active":True,"signedState":2}
