+        raise SurfaceError('ambiguous_prompt' if matches else 'prompt_unavailable')
+    return matches[0]
+
+
+def inspect_get(m, binding, policy, account_hint=None, *, provenance=None):
+    try:
+        _handle, _url, selected, fingerprint, parsed = _inspect(m, binding, policy, account_hint, provenance)
+        return {'ok': True, 'state': 'ready', **parsed, 'rowFingerprint': fingerprint,
+                'rpId': selected['rpId'], 'account': selected['account']}
+    except (SurfaceError, PolicyError) as exc:
+        return {'ok': False, 'state': 'verification_required' if getattr(exc, 'code', '') == 'verification_required' else 'refused',
+                'errorCode': getattr(exc, 'code', 'policy_refused')}
+
+
+def approve_get(m, binding, policy, account_hint=None, *, provenance=None):
+    """One native UI click after caller durably records the inspected attempt."""
+    if (not isinstance(binding, dict) or not binding.get('sessionId')
+            or not isinstance(binding.get('rowFingerprint'), str)
+            or not re.fullmatch(r'[0-9a-f]{64}', binding['rowFingerprint'])):
+        return {'ok': False, 'state': 'refused', 'errorCode': 'inspection_required'}
+    sent = False
