@@ -0,0 +1,42 @@
+import { createBitwardenBroker } from '../../plugins/bitwarden-unlock/runtime.js';
+import { requestHumanControl, hasHumanControl } from '../../lib/human-control.js';
+import { reserveExternalControl } from '../../lib/external-control.js';
+
+test('automatic and explicit relock can preempt human focus without resuming the human tab', async () => {
+  const tab = { toolCalls: 1 }, session = { tabGroups: new Map([['task', new Map([['tab', tab]])]]) };
+  const sessions = new Map([['owner', session]]), controls = new Map(), calls = [];
+  let expire;
+  const broker = createBitwardenBroker({ ensureBrowser: async () => {}, isBrowserBusy: () => false,
+    schedule: callback => { expire = callback; return { unref() {} }; },
+    onHumanControl: lease => reserveExternalControl(controls, sessions, lease),
+    clearHumanControl: id => controls.delete(id),
+    driver: async ({ action }) => { calls.push(action); return { ok: true, state: action === 'lock' ? 'locked' : 'unlocked' }; },
+  });
+  const op = await broker.requestUnlock('owner', 30);
+  await broker.deliver({ operationId: op.operationId, browserInstance: op.browserInstance, masterPassword: 'dummy-review-only' });
+  requestHumanControl(tab, { reason: 'manual' });
+  expire(); await new Promise(setImmediate);
+  expect(calls).toEqual(['unlock', 'lock']);
+  expect(broker.operation('owner', op.operationId).state).toBe('expired');
+  expect(hasHumanControl(tab)).toBe(true);
+  expect(controls.size).toBe(0);
+  expect((await broker.lock('owner')).ok).toBe(true);
+  expect(hasHumanControl(tab)).toBe(true);
+  await broker.close();
+});
+test('a reservation hook exception cannot silently skip revocation', async () => {
+  let expire, failReservation = false;
+  const calls = [];
+  const broker = createBitwardenBroker({ ensureBrowser: async () => {}, isBrowserBusy: () => false,
+    schedule: callback => { expire = callback; return { unref() {} }; },
+    onHumanControl: () => { if (failReservation) throw new Error('reservation unavailable'); },
+    driver: async ({ action }) => { calls.push(action); return { ok: true, state: action === 'lock' ? 'locked' : 'unlocked' }; },
+  });
+  const op = await broker.requestUnlock('owner', 30);
+  await broker.deliver({ operationId: op.operationId, browserInstance: op.browserInstance, masterPassword: 'dummy-review-only' });
+  failReservation = true;
+  expire(); await new Promise(setImmediate);
+  expect(calls).toEqual(['unlock', 'lock']);
+  expect(broker.operation('owner', op.operationId).state).toBe('expired');
+  await broker.close();
+});
