+        state = p.debug_snapshot()
+        self.assertEqual(state["captureCount"], 1)
+        self.assertEqual(state["bcId"], "9")
+        self.assertFalse(any("url" in key.lower() or "sender" in key.lower() for key in state))
+        self.assertNotIn("moz-extension", repr(state))
+
+    def test_close_removes_observer_and_forgets_local_owner(self):
+        m = FakeMarionette()
+        p = PopupProvenance(m, EXT, deadline())
+        p.arm()
+        p.close()
+        self.assertFalse(p._armed)
+        self.assertIsNone(p._owner)
+        self.assertTrue(any(c[0] == "execute_script" and c[1] == _CLOSE_JS for c in m.calls))
+
+    def test_close_uses_another_live_chrome_window_if_owner_closed(self):
+        m = FakeMarionette()
+        p = PopupProvenance(m, EXT, deadline())
+        p.arm()
+        m.unavailable_handles.add("browser-window")
+        m.chrome_window_handles.append("second-browser-window")
+        p.close()
+        close_calls = [c for c in m.calls if c[0] == "execute_script" and c[1] == _CLOSE_JS]
+        self.assertEqual(len(close_calls), 1)
+        self.assertEqual(close_calls[0][4], "second-browser-window")
+        self.assertFalse(p._armed)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/plugins/bitwarden-unlock/vaultwarden-deliver.py b/plugins/bitwarden-unlock/vaultwarden-deliver.py
new file mode 100644
index 0000000..f291373
--- /dev/null
+++ b/plugins/bitwarden-unlock/vaultwarden-deliver.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+"""Host-side fixed-destination adapter for a systemd encrypted credential.
+
+Run only inside the dedicated owner-authorized credential service. This does
+not add a master-password export operation to the collector or HTTP API.
+"""
+import argparse
+import json
+import os
+from pathlib import Path
+import pwd
+import re
+import stat
+import subprocess
+import sys
+import uuid
+
+OWNER = "camofox"
+CONFIG = Path("/etc/camofox-extension-broker/config.json")
+HELPER = "/opt/camofox-browser/plugins/bitwarden-unlock/broker-unlock.py"
+REQUESTS = Path("/run/camofox-extension-broker/requests")
+
+
+def private_file(path, limit, owner_uid):
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
+    with os.fdopen(fd, "rb") as stream:
+        info = os.fstat(stream.fileno())
+        if not stat.S_ISREG(info.st_mode) or info.st_uid != owner_uid or stat.S_IMODE(info.st_mode) & 0o077 or info.st_size > limit:
+            raise ValueError()
+        value = stream.read(limit + 1)
+    if not value or len(value) > limit:
+        raise ValueError()
+    return value.decode("utf-8")
+
+
+def destination_config():
+    # Config is non-secret, but must be owned by root or the designated owner,
+    # and must not be writable by other principals. Never accept a destination
+    # or an arbitrary Docker command in an operation request.
+    fd = os.open(CONFIG, os.O_RDONLY | os.O_NOFOLLOW)
+    with os.fdopen(fd, "r", encoding="utf-8") as stream:
+        info = os.fstat(stream.fileno())
+        if not stat.S_ISREG(info.st_mode) or info.st_uid not in (0, os.getuid()) or info.st_mode & 0o022 or info.st_size > 4096:
+            raise ValueError()
+        cfg = json.load(stream)
+    if set(cfg) != {"containerName", "expectedImageId", "email"}:
+        raise ValueError()
+    if not isinstance(cfg["containerName"], str) or not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}", cfg["containerName"]):
+        raise ValueError()
+    if not isinstance(cfg["expectedImageId"], str) or not re.fullmatch(r"sha256:[0-9a-f]{64}", cfg["expectedImageId"]):
+        raise ValueError()
+    if not isinstance(cfg["email"], str) or not cfg["email"] or len(cfg["email"]) > 320:
+        raise ValueError()
+    return cfg
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--operation-id", required=True)
+    args = parser.parse_args()
+    request_path = None
+    try:
+        if os.getuid() != pwd.getpwnam(OWNER).pw_uid:
+            raise ValueError()
+        parsed_operation_id = uuid.UUID(args.operation_id)
+        operation_id = str(parsed_operation_id)
+        if operation_id != args.operation_id or parsed_operation_id.version != 4 or parsed_operation_id.variant != uuid.RFC_4122:
+            raise ValueError()
+        request_path = REQUESTS / (operation_id + ".json")
+        request = json.loads(private_file(request_path, 4096, os.getuid()))
+        if set(request) != {"operationId", "browserInstance"} or request["operationId"] != operation_id:
+            raise ValueError()
+        parsed_browser_instance = uuid.UUID(request["browserInstance"])
+        browser_instance = str(parsed_browser_instance)
+        if browser_instance != request["browserInstance"] or parsed_browser_instance.version != 4 or parsed_browser_instance.variant != uuid.RFC_4122:
+            raise ValueError()
+        cfg = destination_config()
+        inspected = subprocess.run(["/usr/bin/docker", "inspect", "--format", "{{json .Id}}|{{json .Image}}|{{json .State.Running}}", cfg["containerName"]], capture_output=True, text=True, timeout=10, check=True)
+        target_id, target_image, running = [json.loads(part) for part in inspected.stdout.strip().split("|")]
+        if target_image != cfg["expectedImageId"] or running is not True:
+            raise ValueError()
+        container_id = target_id
+        if not re.fullmatch(r"[0-9a-f]{64}", container_id):
+            raise ValueError()
+        helper_command = ["/usr/bin/docker", "exec", "-i", "--user", "911:911", container_id, "python3", HELPER,
+                          "--operation-id", operation_id, "--browser-instance", browser_instance]
+        check = subprocess.run(helper_command + ["--check"], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=10, check=False)
+        ready = json.loads(check.stdout)
+        if check.returncode or ready.get("ok") is not True or ready.get("state") != "awaiting_secret" or ready.get("operationId") != operation_id or ready.get("browserInstance") != browser_instance:
+            raise ValueError()
+        credential_dir = os.environ.get("CREDENTIALS_DIRECTORY")
+        if not credential_dir or not Path(credential_dir).is_absolute():
+            raise ValueError()
+        master = private_file(Path(credential_dir) / "vault-unlock", 4096, os.getuid())
+        # Pin the resolved container ID, UID and helper. The secret travels
+        # directly from systemd's private credential file to helper stdin.
+        proc = subprocess.run(helper_command,
+                              input=json.dumps({"email": cfg["email"], "masterPassword": master}), capture_output=True,
+                              text=True, timeout=70, check=False)
+        master = None
+        reply = json.loads(proc.stdout)
+        allowed_states = {"unlocked", "two_factor_required", "failed", "cancelled", "expired", "locked", "lock_failed"}
+        output = {"ok": reply.get("ok") is True and proc.returncode == 0, "operationId": operation_id}
+        if reply.get("state") in allowed_states:
+            output["state"] = reply["state"]
+        if not output["ok"]:
+            output["errorCode"] = "unlock_not_completed"
+        print(json.dumps(output), flush=True)
+        return 0 if output["ok"] else 1
+    except Exception:
+        print(json.dumps({"ok": False, "errorCode": "vault_delivery_unavailable"}), flush=True)
+        return 1
+    finally:
+        if request_path:
+            try:
+                request_path.unlink()
+            except OSError:
+                pass
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/plugins/human-control/index.js b/plugins/human-control/index.js
new file mode 100644
index 0000000..22dfc30
--- /dev/null
+++ b/plugins/human-control/index.js
@@ -0,0 +1,196 @@
+import {
+  assertNoOtherHumanControl, detectHumanChallenge, humanControlState,
+  markHumanControlFocused, renewHumanControl, requestHumanControl, resumeHumanControl,
+} from '../../lib/human-control.js';
+
+function find(ctx, req) {
+  const raw = req.body?.userId || req.query?.userId;
+  if (typeof raw !== 'string' || !raw) throw Object.assign(new Error('userId required'), { statusCode: 400 });
+  const session = ctx.sessions.get(ctx.normalizeUserId(raw));
+  if (session?._closing) throw Object.assign(new Error('Session is closing; handoff cannot acquire it'), { statusCode: 409 });
+  for (const group of session?.tabGroups?.values() || []) {
+    const tabState = group.get(req.params.tabId);
+    if (tabState) return { session, tabState };
+  }
+  throw Object.assign(new Error('Tab not found'), { statusCode: 404 });
+}
+
+export function register(app, ctx, pluginConfig = {}) {
+  if (typeof ctx.withHumanControlLock !== 'function') throw new Error('human-control requires the core withHumanControlLock capability');
+  if (typeof ctx.hasActiveBrowserRequests !== 'function') throw new Error('human-control requires the core active-request registry');
+  let desktopUrl = null;
+  if (pluginConfig.desktopUrl) {
+    const parsed = new URL(pluginConfig.desktopUrl);
+    if (!['http:', 'https:'].includes(parsed.protocol) || parsed.username || parsed.password || parsed.search || parsed.hash) {
+      throw new Error('human-control desktopUrl must be an HTTP(S) desktop URL without credentials, query, or fragment');
+    }
+    desktopUrl = parsed.href;
+  }
+  const handle = (operation) => async (req, res) => {
+    try {
+      const found = find(ctx, req);
+      const result = await ctx.withHumanControlLock(req.params.tabId, async () => {
+        // A queued close or recovery may have replaced the original state.
+        const current = find(ctx, req);
+        if (current.tabState !== found.tabState) throw Object.assign(new Error('Tab changed; read handoff status again'), { statusCode: 409 });
+        const body = await operation(current, req);
+        current.session.lastAccess = Date.now();
+        return body;
+      });
+      return res.json({ ok: true, tabId: req.params.tabId, ...result });
+    } catch (err) {
+      return res.status(err.statusCode || 500).json({ ok: false, error: ctx.safeError(err), ...(err.code ? { code: err.code } : {}) });
+    }
+  };
+
+  /**
+   * @openapi
+   * /tabs/{tabId}/handoff:
+   *   get:
+   *     tags: [Tabs]
+   *     summary: Read human-control state and CAPTCHA signals without reading page content
+   *     parameters:
+   *       - { name: tabId, in: path, required: true, schema: { type: string } }
+   *       - { name: userId, in: query, required: true, schema: { type: string } }
+   *     responses:
+   *       200: { description: Handoff state and non-secret challenge signals. }
+   *       404: { description: Tab not found. }
+   *   post:
+   *     tags: [Tabs]
+   *     summary: Pause automation and focus an existing tab for a human
+   *     parameters:
+   *       - { name: tabId, in: path, required: true, schema: { type: string } }
+   *     requestBody:
+   *       required: true
+   *       content:
+   *         application/json:
+   *           schema:
+   *             type: object
+   *             required: [userId]
+   *             properties:
+   *               userId: { type: string }
+   *               reason: { type: string, enum: [captcha, login, mfa, manual] }
+   *               ttlSeconds: { type: integer, minimum: 30, maximum: 1800, default: 900 }
+   *     responses:
+   *       200: { description: Existing tab retained; automation paused until explicit resume. }
+   *       409: { description: Another handoff owns the shared desktop. }
+   */
+  app.get('/tabs/:tabId/handoff', ctx.auth(), handle(async ({ tabState }) => ({
+    ...humanControlState(tabState),
+    challenge: await detectHumanChallenge(tabState.page),
+    desktopUrl,
+  })));
+
+  app.post('/tabs/:tabId/handoff', ctx.auth(), handle(async ({ tabState }, req) => {
+    assertNoOtherHumanControl(ctx.sessions, tabState);
+    if (ctx.hasActiveBrowserRequests(req)) {
+      throw Object.assign(new Error('A browser request is still in flight. Wait for it to finish before handing control to the human.'), { statusCode: 409, code: 'browser_busy' });
+    }
+    // No await between the idle check and lease assignment: new requests must
+    // observe the pause before any focus/detection work yields to the event loop.
+    requestHumanControl(tabState, { reason: req.body?.reason, ttlSeconds: req.body?.ttlSeconds });
+    let focusWarning;
+    try {
+      await tabState.page.bringToFront();
+      markHumanControlFocused(tabState);
+    } catch {
+      focusWarning = 'The tab is preserved and paused; select it manually in the shared desktop.';
+    }
+    return {
+      ...humanControlState(tabState),
+      challenge: await detectHumanChallenge(tabState.page),
+      desktopUrl,
+      instructions: 'Use this existing tab in the shared desktop. Keep it open, renew before expiry, and explicitly confirm completion before resuming automation.',
+      ...(focusWarning ? { focusWarning } : {}),
+    };
+  }));
+
+  /**
+   * @openapi
+   * /tabs/{tabId}/handoff/renew:
+   *   post:
+   *     tags: [Tabs]
+   *     summary: Renew the current human-control lease without replacing the tab
+   *     parameters:
+   *       - { name: tabId, in: path, required: true, schema: { type: string } }
+   *     requestBody:
+   *       required: true
+   *       content:
+   *         application/json:
+   *           schema:
+   *             type: object
+   *             required: [userId, leaseId]
+   *             properties:
+   *               userId: { type: string }
+   *               leaseId: { type: string }
+   *               ttlSeconds: { type: integer, minimum: 30, maximum: 1800, default: 900 }
+   *     responses:
+   *       200: { description: Lease renewed. }
+   *       409: { description: Lease changed or another tab owns human control. }
+   */
+  app.post('/tabs/:tabId/handoff/renew', ctx.auth(), handle(async ({ tabState }, req) => {
+    assertNoOtherHumanControl(ctx.sessions, tabState);
+    return renewHumanControl(tabState, { leaseId: req.body?.leaseId, ttlSeconds: req.body?.ttlSeconds });
+  }));
+
+  /**
+   * @openapi
+   * /tabs/{tabId}/handoff/resume:
+   *   post:
+   *     tags: [Tabs]
+   *     summary: Return control only after explicit human completion confirmation
+   *     parameters:
+   *       - { name: tabId, in: path, required: true, schema: { type: string } }
+   *     requestBody:
+   *       required: true
+   *       content:
+   *         application/json:
+   *           schema:
+   *             type: object
+   *             required: [userId, leaseId, humanConfirmed]
+   *             properties:
+   *               userId: { type: string }
+   *               leaseId: { type: string }
+   *               humanConfirmed: { type: boolean, enum: [true] }
+   *     responses:
+   *       200: { description: Human explicitly confirmed completion; tab ready to resume. }
+   *       400: { description: Explicit human confirmation missing. }
+   *       409: { description: Lease changed. }
+   */
+  app.post('/tabs/:tabId/handoff/resume', ctx.auth(), handle(async ({ tabState }, req) => {
+    const challenge = await detectHumanChallenge(tabState.page);
+    return {
+      ...resumeHumanControl(tabState, { leaseId: req.body?.leaseId, humanConfirmed: req.body?.humanConfirmed }),
+      challenge,
+      verification: 'human_confirmed',
+    };
+  }));
+
+  /**
+   * @openapi
+   * /tabs/{tabId}/focus:
+   *   post:
+   *     tags: [Tabs]
+   *     summary: Focus an existing tab without creating a new browser session
+   *     parameters:
+   *       - { name: tabId, in: path, required: true, schema: { type: string } }
+   *     requestBody:
+   *       required: true
+   *       content:
+   *         application/json:
+   *           schema:
+   *             type: object
+   *             required: [userId]
+   *             properties:
+   *               userId: { type: string }
+   *     responses:
+   *       200: { description: Existing tab focused. }
+   *       409: { description: Another handoff owns the shared desktop. }
+   */
+  app.post('/tabs/:tabId/focus', ctx.auth(), handle(async ({ tabState }) => {
+    assertNoOtherHumanControl(ctx.sessions, tabState);
+    await tabState.page.bringToFront();
+    markHumanControlFocused(tabState);
+    return { focused: true, ...humanControlState(tabState) };
+  }));
+}
diff --git a/plugins/recaptcha/index.js b/plugins/recaptcha/index.js
new file mode 100644
index 0000000..6c32b89
--- /dev/null
+++ b/plugins/recaptcha/index.js
@@ -0,0 +1,202 @@
+/**
+ * reCAPTCHA tool plugin for camofox-browser.
+ *
+ * Camofox's core routes only reach the main frame, and its click route accepts
+ * ref/selector (the documented `coordinates` field is not implemented). Captcha
+ * challenges live in cross-origin iframes, so no page-JS path can see or click
+ * them. This plugin adds the missing primitives:
+ *
+ *   GET  /recaptcha/frames      ?userId&tabId                  -> [{url, name}]
+ *   POST /recaptcha/frame_eval  {userId, tabId, frameMatch, expression}
+ *   POST /recaptcha/frame_click {userId, tabId, frameMatch, selector, index} -> trusted click in a (cross-origin) frame
+ *   POST /recaptcha/click       {userId, tabId, x, y}          -> trusted click at viewport coords (main frame only)
+ *   POST /recaptcha/tiles       {userId, tabId, frameMatch}    -> {prompt, cells}
+ *
+ * NOTE ON INPUT: raw page.mouse.move() never resolves in this Camoufox/Playwright
+ * build (it hangs until the page is destroyed), so clicks go through
+ * elementFromPoint + locator.click() (main frame) and frame-scoped locators
+ * (iframe content). locator.click() dispatches trusted input.
+ *
+ * No vision model is called here — classification stays in the caller.
+ */
+
+function findTab(session, tabId) {
+  for (const [listItemId, group] of session.tabGroups) {
+    if (group.has(tabId)) return { tabState: group.get(tabId), listItemId, group };
+  }
+  return null;
+}
+
+function resolve(ctx, userId, tabId) {
+  const session = ctx.sessions.get(ctx.normalizeUserId(userId));
+  if (!session) return null;
+  const found = findTab(session, tabId);
+  if (!found) return null;
+  session.lastAccess = Date.now();
+  return found;
+}
+
+async function pickFrame(page, match, requireVisible = false) {
+  const frames = page.frames();
+  if (!match) return frames[0];
+  let visibleSrcs = null;
+  if (requireVisible) {
+    try {
+      visibleSrcs = await page.evaluate(() =>
+        [...document.querySelectorAll('iframe')]
+          .filter((f) => f.offsetParent !== null && f.getClientRects().length > 0)
+          .map((f) => f.getAttribute('src') || ''));
+    } catch {
+      visibleSrcs = null;
+    }
+  }
+  const cands = frames.filter((f) => f.url().includes(match));
+  if (!cands.length) return null;
+  if (visibleSrcs && visibleSrcs.length) {
+    const vis = cands.filter((f) => visibleSrcs.some((s) => s && (f.url() === s || f.url().startsWith(s.slice(0, 120)))));
+    if (vis.length) return vis[vis.length - 1]; // newest visible frame
+  }
+  return cands[cands.length - 1]; // newest candidate
+}
+
+function badSelector(selector) {
+  return typeof selector !== 'string' || !selector.length || selector.length > 300;
+}
+
+export async function register(app, ctx, config) {
+  app.get('/recaptcha/frames', ctx.auth(), async (req, res) => {
+    const found = resolve(ctx, req.query.userId, req.query.tabId);
+    if (!found) return res.status(404).json({ ok: false, error: 'tab not found' });
+    try {
+      const frames = found.tabState.page.frames().map((f) => ({ url: f.url(), name: f.name() }));
+      return res.json({ ok: true, frames });
+    } catch (err) {
+      return res.status(500).json({ ok: false, error: ctx.safeError(err) });
+    }
+  });
+
+  app.post('/recaptcha/frame_eval', ctx.auth(), async (req, res) => {
+    const { userId, tabId, frameMatch, expression } = req.body || {};
+    if (!userId || !tabId || !expression) return res.status(400).json({ ok: false, error: 'userId, tabId, expression required' });
+    const found = resolve(ctx, userId, tabId);
+    if (!found) return res.status(404).json({ ok: false, error: 'tab not found' });
+    try {
+      const frame = await pickFrame(found.tabState.page, frameMatch, true);
+      if (!frame) return res.status(404).json({ ok: false, error: 'frame not found' });
+      const result = await ctx.withUserLimit(ctx.normalizeUserId(userId), () =>
+        frame.evaluate(expression).catch((e) => ({ err: e.message })));
+      return res.json({ ok: true, frame: frame.url(), result });
+    } catch (err) {
+      return res.status(500).json({ ok: false, error: ctx.safeError(err) });
+    }
+  });
+
+  app.post('/recaptcha/frame_click', ctx.auth(), async (req, res) => {
+    const { userId, tabId, frameMatch, selector, index = 0 } = req.body || {};
+    if (!userId || !tabId) return res.status(400).json({ ok: false, error: 'userId and tabId required' });
+    if (!frameMatch) return res.status(400).json({ ok: false, error: 'frameMatch required' });
+    if (badSelector(selector)) return res.status(400).json({ ok: false, error: 'selector required (string, <300 chars)' });
+    const found = resolve(ctx, userId, tabId);
+    if (!found) return res.status(404).json({ ok: false, error: 'tab not found' });
+    try {
+      const page = found.tabState.page;
+      await ctx.withUserLimit(ctx.normalizeUserId(userId), async () => {
+        const frame = await pickFrame(page, frameMatch, true);
+        if (!frame) throw Object.assign(new Error('frame not found'), { statusCode: 404 });
+        const count = await frame.locator(selector).count();
+        if (count <= index) throw Object.assign(new Error(`selector matched ${count} elements, index ${index} out of range`), { statusCode: 422 });
+        await frame.locator(selector).nth(index).click({ timeout: 15000 });
+      });
+      ctx.log('info', 'recaptcha frame_click', { tabId, frameMatch, index });
+      return res.json({ ok: true, clicked: { frameMatch, selector, index } });
+    } catch (err) {
+      return res.status(err.statusCode || 500).json({ ok: false, error: ctx.safeError(err) });
+    }
+  });
+
+  app.post('/recaptcha/click', ctx.auth(), async (req, res) => {
+    const { userId, tabId, x, y } = req.body || {};
+    if (!userId || !tabId) return res.status(400).json({ ok: false, error: 'userId and tabId required' });
+    if (typeof x !== 'number' || typeof y !== 'number') return res.status(400).json({ ok: false, error: 'x and y must be numbers' });
+    const found = resolve(ctx, userId, tabId);
+    if (!found) return res.status(404).json({ ok: false, error: 'tab not found' });
+    try {
+      const page = found.tabState.page;
+      await ctx.withUserLimit(ctx.normalizeUserId(userId), async () => {
+        const hit = await page.evaluate((pt) => {
+          const el = document.elementFromPoint(pt.x, pt.y);
+          if (!el) return { none: true };
+          if (el.tagName === 'IFRAME') {
+            const r = el.getBoundingClientRect();
+            return { iframe: true, relX: Math.round(pt.x - r.left), relY: Math.round(pt.y - r.top), src: el.getAttribute('src') || '' };
+          }
+          el.setAttribute('data-rc-click', '1');
+          return { tagged: true };
+        }, { x, y });
+        if (hit.none) throw Object.assign(new Error('no element at point'), { statusCode: 422 });
+        if (hit.iframe) throw Object.assign(new Error(`point is over iframe (${(hit.src || '').slice(0, 60)}); use /recaptcha/frame_click`), { statusCode: 422 });
+        try {
+          await page.locator('[data-rc-click]').first().click({ timeout: 15000 });
+        } finally {
+          await page.evaluate(() => { const el = document.querySelector('[data-rc-click]'); if (el) el.removeAttribute('data-rc-click'); });
+        }
+      });
+      ctx.log('info', 'recaptcha click via elementFromPoint', { tabId, x: x.toFixed(0), y: y.toFixed(0) });
