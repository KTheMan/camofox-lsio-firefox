+import { jest } from '@jest/globals';
+import { privateScreenshot, PRIVATE_SCREENSHOT_SELECTOR } from '../../lib/private-screenshot.js';
+
+test('masks controls in every frame without evaluating or mutating page values', async () => {
+  const locators = [{ frame: 'main' }, { frame: 'child' }];
+  const frames = locators.map(locator => ({ locator: jest.fn(() => locator) }));
+  const page = { frames: () => frames, screenshot: jest.fn(async options => options) };
+  const result = await privateScreenshot(page, { type: 'png', fullPage: true, mask: [], maskColor: '#ffffff' });
+  expect(result).toEqual({ type: 'png', fullPage: true, mask: locators, maskColor: '#FF00FF' });
+  for (const frame of frames) expect(frame.locator).toHaveBeenCalledWith(PRIVATE_SCREENSHOT_SELECTOR);
+});
diff --git a/tests/unit/snapshotStructurePrivacy.test.js b/tests/unit/snapshotStructurePrivacy.test.js
new file mode 100644
