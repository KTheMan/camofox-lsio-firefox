new file mode 100644
index 0000000..8f7c4e8
--- /dev/null
+++ b/plugins/bitwarden-unlock/extension_contract.py
@@ -0,0 +1,223 @@
+"""Fail-closed validation for the Bitwarden extension boundary."""
+
+from __future__ import annotations
+
+import re
+import uuid
+from urllib.parse import parse_qsl, urlsplit
+
+
+_SERVICES = {
+    "webVault": "",
+    "api": "/api",
+    "identity": "/identity",
+    "icons": "/icons",
+    "notifications": "/notifications",
+    "events": "/events",
+}
+_ENV_FIELDS = frozenset(("base", *_SERVICES))
+_HEX = frozenset("0123456789abcdefABCDEF")
+_DNS_LABEL = re.compile(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\Z")
+_POSITIVE_DECIMAL = re.compile(r"[1-9][0-9]*\Z")
+_FRAME_ID = re.compile(r"mainframe-[1-9][0-9]*\Z")
+
+
+def _has_valid_percent_escapes(value: str) -> bool:
+    i = 0
+    while i < len(value):
+        if value[i] == "%":
+            if i + 2 >= len(value) or value[i + 1] not in _HEX or value[i + 2] not in _HEX:
+                return False
+            i += 3
+        else:
+            i += 1
+    return True
+
+
+def _https_url(value: object):
+    """Parse an HTTPS URL without userinfo; return None for malformed input."""
+    if not isinstance(value, str) or not value or any(c.isspace() or ord(c) < 0x20 for c in value):
+        return None
+    if not _has_valid_percent_escapes(value):
+        return None
+    try:
+        parsed = urlsplit(value)
+        hostname = parsed.hostname
+        port = parsed.port
+    except (ValueError, UnicodeError):
+        return None
+    if parsed.scheme.lower() != "https" or not parsed.netloc or not hostname:
+        return None
+    if parsed.username is not None or parsed.password is not None or "@" in parsed.netloc:
+        return None
+    if port is not None and not 1 <= port <= 65535:
+        return None
+    if "\\" in parsed.netloc or "%" in parsed.netloc:
+        return None
+    return parsed
+
+
+def _https_origin(value: object) -> tuple[str, str] | None:
+    """Return (serialized origin, authority) for a bare HTTPS origin."""
+    parsed = _https_url(value)
+    if parsed is None or parsed.path or parsed.query or parsed.fragment:
+        return None
+    # Requiring the original to be exactly this serialization also excludes
+    # empty path/query/fragment delimiters and credentials hidden by parsing.
+    origin = f"https://{parsed.netloc}"
+    if value != origin:
+        return None
+    return origin, parsed.netloc
+
+
+def valid_environment(env: object, expected_origin: object) -> bool:
+    """Validate the exact Bitwarden server origin and optional service paths."""
+    expected = _https_origin(expected_origin)
+    if expected is None or not isinstance(env, dict):
+        return False
+    if any(not isinstance(key, str) for key in env) or set(env) - _ENV_FIELDS:
+        return False
+    base = env.get("base")
+    if _https_origin(base) != expected:
+        return False
+    origin, authority = expected
+    for name, path in _SERVICES.items():
+        if name not in env:
+            continue
+        value = env[name]
+        if not isinstance(value, str) or value != f"{origin}{path}":
+            return False
+        parsed = _https_url(value)
+        if parsed is None or parsed.netloc != authority or parsed.path != path or parsed.query or parsed.fragment:
+            return False
+    return True
+
+
+def _canonical_uuid(value: object) -> bool:
+    if not isinstance(value, str):
+        return False
+    try:
+        return str(uuid.UUID(value)) == value
+    except (ValueError, AttributeError, TypeError):
+        return False
+
+
+def _strict_query(query: str):
+    try:
+        pairs = parse_qsl(query, keep_blank_values=True, strict_parsing=True,
+                          encoding="utf-8", errors="strict", separator="&")
+    except (ValueError, UnicodeError):
+        return None
+    values = {}
+    for key, value in pairs:
+        if key in values:
+            return None
+        values[key] = value
+    return values
+
+
+def _valid_rp_id(rp_id: object) -> bool:
+    if not isinstance(rp_id, str) or not rp_id or len(rp_id) > 253 or not rp_id.isascii():
+        return False
+    if rp_id != rp_id.lower() or rp_id.endswith("."):
+        return False
+    labels = rp_id.split(".")
+    return len(labels) >= 2 and all(len(label) <= 63 and _DNS_LABEL.fullmatch(label) for label in labels)
+
+
+def _valid_dns_name(host: str) -> bool:
+    if not host or not host.isascii() or len(host) > 253 or host.endswith("."):
+        return False
+    labels = host.lower().split(".")
+    return all(len(label) <= 63 and _DNS_LABEL.fullmatch(label) for label in labels)
+
+
+def _valid_frame_id(frame_id: object) -> bool:
+    return isinstance(frame_id, str) and _FRAME_ID.fullmatch(frame_id) is not None
+
+
+def parse_pending_popup(
+    url: object,
+    extension_uuid: object,
+    expected_url: object,
+    rp_id: object,
+    expected_frame_id: object,
+    sender_frame_id: object,
+) -> dict:
+    """Validate a pending FIDO2 popup URL and return only its trusted IDs.
+
+    All errors are deliberately generic so a rejected URL is never echoed to a
+    caller or log message by this contract helper.
+    """
+    error = ValueError("invalid_pending_popup")
+    if not _canonical_uuid(extension_uuid) or not isinstance(url, str):
+        raise error
+    if not _valid_frame_id(expected_frame_id) or sender_frame_id != expected_frame_id:
+        raise error
+    if not _valid_rp_id(rp_id):
+        raise error
+
+    trusted_url = _https_url(expected_url)
+    if trusted_url is None:
+        raise error
+    try:
+        host = trusted_url.hostname
+    except ValueError:
+        raise error
+    if not _valid_dns_name(host) or not (host == rp_id or host.endswith("." + rp_id)):
+        raise error
+
+    if not _has_valid_percent_escapes(url):
+        raise error
+    try:
+        outer = urlsplit(url)
+    except ValueError:
+        raise error
+    if (outer.scheme != "moz-extension" or outer.netloc != extension_uuid
+            or outer.path != "/popup/index.html" or outer.username is not None
+            or outer.password is not None or outer.port is not None):
+        raise error
+    outer_values = _strict_query(outer.query)
+    if (outer_values is None
+            or set(outer_values) != {"uilocation", "singleActionPopout"}
+            or outer_values.get("uilocation") != "popout"):
+        raise error
+    action_prefix = "vault_Fido2Popout_"
+    action = outer_values.get("singleActionPopout", "")
+    if not action.startswith(action_prefix):
+        raise error
+    action_session = action[len(action_prefix):]
+    if not _canonical_uuid(action_session):
+        raise error
+
+    fragment = outer.fragment
+    if not fragment.startswith("/fido2?"):
+        raise error
+    route, query = fragment.split("?", 1)
+    if route != "/fido2":
+        raise error
+    values = _strict_query(query)
+    allowed = {"sessionId", "senderTabId", "senderUrl", "fallbackSupported"}
+    required = {"sessionId", "senderTabId", "senderUrl"}
+    if values is None or set(values) - allowed or not required.issubset(values):
+        raise error
+    if values.get("fallbackSupported") not in (None, "true", "false"):
+        raise error
+    session_id = values["sessionId"]
+    if not _canonical_uuid(session_id) or session_id != action_session:
+        raise error
+    tab_text = values["senderTabId"]
+    if not _POSITIVE_DECIMAL.fullmatch(tab_text):
+        raise error
+    if values["senderUrl"] != expected_url:
+        raise error
+    return {"sessionId": session_id, "senderTabId": int(tab_text)}
+
+
+def account_matches(label: object, expected_email: object) -> bool:
+    """Match the full accessible Bitwarden account label, ignoring case/space."""
+    if not isinstance(label, str) or not isinstance(expected_email, str):
+        return False
+    normalized_label = " ".join(label.split()).casefold()
+    normalized_email = " ".join(expected_email.split()).casefold()
+    return bool(normalized_email) and normalized_label == f"bitwarden account {normalized_email}"
