+ };
+ const release=async()=>{
+  const c=controller;if(!c)return;
+  stop(c);let timer;
+  try{await Promise.race([c.closed,new Promise((_,reject)=>{timer=setTimeout(()=>{c.forced=true;c.child.kill('SIGKILL');reject(Error('approval_release_failed'))},releaseTimeoutMs);timer.unref?.()})]);if(c.forced)throw Error('approval_release_failed')}
