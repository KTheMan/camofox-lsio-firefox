+"""Mock-only host delivery checks. Never opens an actual credential or Docker."""
+import contextlib
+import importlib.util
+import io
+import json
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+try:
+    import pwd
+except ImportError:
+    sys.modules["pwd"] = SimpleNamespace(getpwnam=lambda _: SimpleNamespace(pw_uid=0))
+
+spec = importlib.util.spec_from_file_location("vaultwarden_deliver", Path(__file__).with_name("vaultwarden-deliver.py"))
+adapter = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(adapter)
+OP = "11111111-1111-4111-8111-111111111111"
+INSTANCE = "22222222-2222-4222-8222-222222222222"
+IMAGE = "sha256:" + "a" * 64
+CONTAINER = "b" * 64
+CFG = {"containerName": "candidate-only", "expectedImageId": IMAGE, "email": "dummy@example.invalid"}
+
+
+class DeliveryTests(unittest.TestCase):
+    def execute(self, ready=True, image=IMAGE):
+        calls, private_reads = [], []
+        def private_file(path, limit, owner):
+            private_reads.append(str(path))
+            return json.dumps({"operationId": OP, "browserInstance": INSTANCE}) if str(path).endswith(".json") else "dummy-private-master"
+        def process(args, **kwargs):
+            calls.append((args, kwargs))
+            if args[1] == "inspect":
+                return SimpleNamespace(stdout="|".join(map(json.dumps, [CONTAINER, image, True])), returncode=0)
+            if args[-1] == "--check":
+                return SimpleNamespace(stdout=json.dumps({"ok": ready, "state": "awaiting_secret", "operationId": OP, "browserInstance": INSTANCE}), returncode=0)
+            return SimpleNamespace(stdout=json.dumps({"ok": True, "state": "unlocked", "inventory": "must-not-escape"}), returncode=0)
+        output = io.StringIO()
+        with patch.object(adapter.os, "getuid", return_value=0, create=True), patch.object(adapter.pwd, "getpwnam", return_value=SimpleNamespace(pw_uid=0)), \
+             patch.object(adapter, "destination_config", return_value=CFG), patch.object(adapter, "private_file", side_effect=private_file), \
+             patch.object(adapter.subprocess, "run", side_effect=process), patch.object(Path, "unlink"), \
+             patch.dict(adapter.os.environ, {"CREDENTIALS_DIRECTORY": str(Path.cwd() / "dummy-credentials")}), \
+             patch.object(sys, "argv", ["vaultwarden-deliver.py", "--operation-id", OP]), contextlib.redirect_stdout(output):
+            code = adapter.main()
+        return code, output.getvalue(), calls, private_reads
+
+    def test_refuses_wrong_image_before_reading_secret(self):
+        code, output, calls, reads = self.execute(image="sha256:" + "c" * 64)
+        self.assertEqual(code, 1)
+        self.assertEqual(len(calls), 1)
+        self.assertFalse(any("vault-unlock" in path for path in reads))
+        self.assertNotIn("dummy-private", output)
+
+    def test_unready_operation_never_causes_secret_retrieval(self):
+        code, output, calls, reads = self.execute(ready=False)
+        self.assertEqual(code, 1)
+        self.assertEqual(len(calls), 2)
+        self.assertFalse(any("vault-unlock" in path for path in reads))
+        self.assertNotIn("dummy-private", output)
+
+    def test_ready_operation_uses_fixed_resolved_destination_and_private_stdin(self):
+        code, output, calls, reads = self.execute()
+        self.assertEqual(code, 0)
+        self.assertEqual(len(calls), 3)
+        arguments, kwargs = calls[-1]
+        self.assertEqual(arguments[:7], ["/usr/bin/docker", "exec", "-i", "--user", "911:911", CONTAINER, "python3"])
+        self.assertEqual(arguments[7], adapter.HELPER)
+        self.assertNotIn("dummy-private", json.dumps(arguments))
+        self.assertEqual(json.loads(kwargs["input"])["masterPassword"], "dummy-private-master")
+        self.assertNotIn("dummy-private", output)
+        self.assertNotIn("inventory", output)
+        self.assertTrue(any("vault-unlock" in path for path in reads))
+
+
+if __name__ == "__main__":
+    unittest.main()
