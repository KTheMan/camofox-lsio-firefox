+  /**
+   * @openapi
+   * /tabs/{tabId}/passkey/approve:
+   *   post:
+   *     tags: [Browser]
+   *     summary: Approve one owned pending native passkey sign-in subject to the host blacklist
+   *     parameters:
+   *       - { name: tabId, in: path, required: true, schema: { type: string } }
+   *     requestBody:
+   *       required: true
+   *       content:
+   *         application/json:
+   *           schema:
+   *             type: object
+   *             additionalProperties: false
+   *             required: [userId, operationId]
+   *             properties:
+   *               userId: { type: string }
+   *               operationId: { type: string, format: uuid }
+   *               accountHint: { type: string, minLength: 1, maxLength: 512 }
+   *     responses:
+   *       200: { description: Approval click sent; caller must verify website login separately. }
+   *       401: { description: Control authentication required. }
+   *       404: { description: Owned tab or operation not found. }
+   *       409: { description: Blacklisted, ambiguous, uncertain, human-owned or mismatched prompt; no replay. }
+   *       503: { description: Native approval unavailable; preserve uncertain state. }
+   */
+  app.post('/tabs/:tabId/passkey/approve', ctx.auth(), route(async (req, res) => {
+    const value=req.body;
+    if (!value || typeof value!=='object' || Array.isArray(value) || Object.keys(value).some(k=>!['userId','operationId','accountHint'].includes(k))) throw new BrokerError('invalid_request',400);
+    const owner=userId(value.userId);
+    if(typeof value.operationId!=='string' || !/^[0-9a-f-]{36}$/.test(value.operationId) || (value.accountHint!==undefined && (typeof value.accountHint!=='string'||!value.accountHint.trim()||value.accountHint.length>512))) throw new BrokerError('invalid_request',400);
