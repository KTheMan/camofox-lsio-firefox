+"""Focused tests for the unreleased controller context-reset candidate."""
+import contextlib
+import importlib.util
+import io
+import pathlib
+import sys
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+PLUGIN = pathlib.Path(__file__).resolve().parent
+sys.path.insert(0, str(PLUGIN))
+SOURCE = pathlib.Path(__file__).with_name("passkey-driver.py")
+spec = importlib.util.spec_from_file_location("passkey_driver_candidate", SOURCE)
+candidate = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = candidate
+spec.loader.exec_module(candidate)
+
+
+class FakeMarionette:
+    def __init__(self):
+        self._chrome_window_handles = ["closed-popout", "normal-chrome"]
+        self._window_handles = ["closed-popout", "pending-popout", "normal-tab"]
+        self.closed = {"closed-popout"}
+        self.unreadable_handles = set()
+        self.context = None
+        self.current_handle = None
+        self.focus_values = []
+        self.frames = []
+
+    @property
+    def chrome_window_handles(self):
+        if self.context != "chrome":
+            raise RuntimeError("chrome handle list requested outside chrome context")
+        return list(self._chrome_window_handles)
+
+    @property
+    def window_handles(self):
+        if self.context != "content":
+            raise RuntimeError("content handle list requested outside content context")
+        return list(self._window_handles)
+
+    def switch_to_window(self, handle, focus=False):
+        self.focus_values.append(focus)
+        if handle in self.closed:
+            if handle in self._window_handles:
+                self._window_handles.remove(handle)
+            raise RuntimeError("closed handle")
+        self.current_handle = handle
+
+    def set_context(self, context):
+        self.context = context
+
+    def switch_to_frame(self):
+        self.frames.append((self.current_handle, self.context))
+
+    def execute_script(self, script, script_args=None):
+        if "window.toolbar?.visible" in script:
+            return self.current_handle == "normal-chrome"
+        raise AssertionError("unexpected script")
+
+    def get_url(self):
+        if self.current_handle in self.unreadable_handles:
+            raise RuntimeError("live handle unreadable")
+        if self.current_handle == "pending-popout":
+            return ("moz-extension://446900e4-71c2-419f-a6a7-df9c091e268b/popup/index.html?"
+                    "uilocation=popout&singleActionPopout=vault_Fido2Popout_demo")
+        if self.current_handle == "normal-tab":
+            return "about:blank"
+        raise RuntimeError("dead browsing context")
+
+
+class CandidateWindowResetTests(unittest.TestCase):
+    def test_selects_valid_normal_window_without_focus_and_skips_dead_popout(self):
+        m = FakeMarionette()
+        selected = candidate.select_live_chrome_window(m, preferred="closed-popout")
+        self.assertEqual(selected, "normal-chrome")
+        self.assertEqual(m.current_handle, "normal-chrome")
+        self.assertEqual(m.context, "chrome")
+        self.assertTrue(m.frames)
+        self.assertTrue(all(value is False for value in m.focus_values))
+
+    def test_pending_skips_closed_handles_and_restores_normal_chrome_context(self):
+        m = FakeMarionette()
+        self.assertTrue(candidate.pending(m, "446900e4-71c2-419f-a6a7-df9c091e268b", preferred="normal-chrome"))
+        self.assertEqual(m.current_handle, "normal-chrome")
+        self.assertEqual(m.context, "chrome")
+        self.assertTrue(all(value is False for value in m.focus_values))
+
+    def test_live_but_unreadable_handle_is_typed_unavailable_not_absent(self):
+        m = FakeMarionette()
+        m._window_handles = ["normal-tab"]
+        m.unreadable_handles.add("normal-tab")
+        result = candidate.pending_status(m, "446900e4-71c2-419f-a6a7-df9c091e268b", preferred="normal-chrome")
+        self.assertEqual(result, {"ok": False, "state": "unknown", "errorCode": "extension_unavailable"})
+        self.assertEqual(m.current_handle, "normal-chrome")
+        self.assertEqual(m.context, "chrome")
+
+    def test_unavailable_context_returns_typed_error_without_worker_exception(self):
+        m = FakeMarionette()
+        m._chrome_window_handles = ["closed-popout"]
+        output = io.StringIO()
+        with contextlib.redirect_stdout(output):
+            ok = candidate.select_request_context(m, None, "approve", "request-1")
+        self.assertFalse(ok)
+        self.assertIn('"state": "rejected"', output.getvalue())
+        self.assertIn('"errorCode": "approval_unavailable"', output.getvalue())
+
+    def test_status_unavailability_is_typed_and_does_not_focus(self):
+        m = FakeMarionette()
+        m._chrome_window_handles = ["closed-popout"]
+        output = io.StringIO()
+        with contextlib.redirect_stdout(output):
+            ok = candidate.select_request_context(m, None, "status", "request-2")
+        self.assertFalse(ok)
+        self.assertIn('"state": "unknown"', output.getvalue())
+        self.assertIn('"errorCode": "extension_unavailable"', output.getvalue())
+        self.assertTrue(all(value is False for value in m.focus_values))
+
+
+if __name__ == "__main__":
+    unittest.main()
