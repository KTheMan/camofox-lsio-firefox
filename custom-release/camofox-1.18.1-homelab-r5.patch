+const { privateKey, publicKey } = generateKeyPairSync('rsa', { modulusLength: 2048 });
+const issuer = 'https://review.cloudflareaccess.com';
+const now = 1_800_000_000_000;
+const jwk = { ...publicKey.export({ format: 'jwk' }), kid: 'review', alg: 'RS256', use: 'sig' };
+function token(changes = {}, head = {}) {
+  const encode = value => Buffer.from(JSON.stringify(value)).toString('base64url');
+  const h = encode({ alg: 'RS256', kid: 'review', ...head });
+  const c = encode({ iss: issuer, aud: ['browser'], exp: now / 1000 + 60, ...changes });
+  const input = `${h}.${c}`;
+  return `${input}.${sign('RSA-SHA256', Buffer.from(input), privateKey).toString('base64url')}`;
+}
+function verifier() {
+  let fetches = 0;
+  const verify = createAccessVerifier({ issuer, audience: 'browser', now: () => now,
+    fetchImpl: async (url, options) => {
+      expect(url).toBe(`${issuer}/cdn-cgi/access/certs`);
+      expect(options.redirect).toBe('error');
+      fetches++;
+      return { ok: true, json: async () => ({ keys: [jwk] }) };
+    },
+  });
+  return { verify, fetches: () => fetches };
+}
+test('valid signature, issuer, audience and live lifetime allow access', async () => {
+  await expect(verifier().verify(token())).resolves.toBe(true);
+});
+test.each([
+  ['wrong audience', { aud: ['other'] }, {}],
+  ['wrong issuer', { iss: 'https://other.cloudflareaccess.com' }, {}],
+  ['expired', { exp: now / 1000 }, {}],
+  ['not yet valid', { nbf: now / 1000 + 5 }, {}],
+  ['string expiry', { exp: '9999999999' }, {}],
+  ['algorithm confusion', {}, { alg: 'HS256' }],
+  ['untrusted key URL', {}, { jku: 'https://untrusted.invalid/certs' }],
+])('rejects %s', async (_name, claims, header) => {
+  await expect(verifier().verify(token(claims, header))).rejects.toMatchObject({ statusCode: 403 });
+});
+test('rejects forged assertion and altered signatures', async () => {
+  const { verify } = verifier();
+  await expect(verify('deliberately-not-a-jwt')).rejects.toMatchObject({ statusCode: 403 });
+  const t = token();
+  const [h, c, sig] = t.split('.');
+  const bad = Buffer.from(sig, 'base64url'); bad[0] ^= 1;
+  await expect(verify(`${h}.${c}.${bad.toString('base64url')}`)).rejects.toMatchObject({ statusCode: 403 });
+});
+test('unknown signing IDs do not cause a fetch for every supplied token', async () => {
+  const check = verifier();
+  await check.verify(token());
+  for (let i = 0; i < 5; i++) await expect(check.verify(token({}, { kid: `unknown-${i}` }))).rejects.toMatchObject({ statusCode: 403 });
+  expect(check.fetches()).toBe(1);
+});
