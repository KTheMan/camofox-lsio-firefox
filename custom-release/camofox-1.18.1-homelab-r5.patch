+#!/usr/bin/env python3
+"""Lease-owned persistent native UI controller. No credentials or signing SDK."""
+import os,sys,json,hashlib,time
+from urllib.parse import urlsplit
+sys.path.insert(0,os.path.dirname(__file__))
+from driver import ensure_extension,ADDON_ID,wait_state,result as bw_result,DriverError
+from extension_contract import valid_environment
+from extension_surface import ToolbarPopup, WIDGET_ID
+from approval_policy import load_policy_file,PolicyError
+from passkey_surface import inspect_get,approve_get
+from popup_provenance import PopupProvenance
+sys.path.insert(0,os.path.join(os.path.dirname(__file__),'pylibs'))
+from marionette_driver.marionette import Marionette
+
+def reject(code='approval_unavailable'):return {'ok':False,'state':'rejected','errorCode':code}
+def line():
+ raw=sys.stdin.readline(16386)
+ if not raw or not raw.endswith('\n') or len(raw.encode())>16384:raise ValueError()
+ v=json.loads(raw)
+ if not isinstance(v,dict):raise ValueError()
+ return v
+def emit(ident,phase,value):print(json.dumps({'id':ident,'phase':phase,'result':value}),flush=True)
+def policy():
+ p=load_policy_file(os.environ.get('CAMOFOX_PASSKEY_POLICY_FILE',os.path.join(os.path.dirname(__file__),'passkey-blacklist.json')))
+ h=hashlib.sha256(json.dumps([sorted(p.blocked_origins),sorted(p.blocked_rp_ids),sorted(p.blocked_accounts)],separators=(',',':')).encode()).hexdigest()
+ return p,h
+def select_live_chrome_window(m, preferred=None):
+ """Select a live normal browser chrome context without focusing its window."""
+ try:
+  m.set_context('chrome');handles=list(m.chrome_window_handles)
+ except Exception: raise DriverError('controller_window_unavailable') from None
+ candidates=[]
+ check="return !!window.gBrowser && window.toolbar?.visible === true && !!document.getElementById(arguments[0]);"
+ for handle in handles:
+  try:
+   m.switch_to_window(handle,focus=False);m.set_context('chrome');m.switch_to_frame()
+   if m.execute_script(check,script_args=[WIDGET_ID]) is True:candidates.append(handle)
+  except Exception:continue
+ if not candidates:raise DriverError('controller_window_unavailable')
+ selected=preferred if preferred in candidates else candidates[0]
+ try:
+  m.switch_to_window(selected,focus=False);m.set_context('chrome');m.switch_to_frame()
+ except Exception:raise DriverError('controller_window_unavailable') from None
+ return selected
+def pending(m,ext,preferred=None):
+ select_live_chrome_window(m,preferred)
+ found=False
+ try:
+  try:m.set_context('content');handles=list(m.window_handles)
+  except Exception:raise DriverError('controller_window_unavailable') from None
+  for handle in handles:
+   try:
+    m.set_context('content');m.switch_to_window(handle,focus=False);m.set_context('content');m.switch_to_frame()
+    u=urlsplit(m.get_url())
+    if u.scheme=='moz-extension' and u.netloc==ext and u.path=='/popup/index.html' and 'singleActionPopout=vault_Fido2Popout_' in u.query:
+     found=True;break
+   except Exception:
+    try:
+     m.set_context('content');still_live=handle in list(m.window_handles)
+    except Exception:raise DriverError('controller_window_unavailable') from None
+    if still_live:raise DriverError('controller_window_unavailable') from None
+  return found
+ finally:
+  select_live_chrome_window(m,preferred)
+def pending_status(m,ext,preferred=None):
+ try:return {'ok':True,'state':'passkey_pending' if pending(m,ext,preferred) else 'not_pending'}
+ except DriverError:return bw_result('unknown',False,'extension_unavailable')
+def select_request_context(m,provenance,action,ident):
+ try:
+  select_live_chrome_window(m,getattr(provenance,'_owner',None))
+  return True
+ except DriverError:
+  if action=='status':emit(ident,'final',bw_result('unknown',False,'extension_unavailable'))
+  elif action=='approve':emit(ident,'final',reject())
+  else:return False
+  return False
+def main():
+ m=None;ident=None;provenance=None
+ try:
+  first=line();ident=first.get('id')
+  if set(first)!={'id','action','expectedServerOrigin','expiresAt'} or first['action']!='arm':raise ValueError()
+  expected=first['expectedServerOrigin'];policy()
+  deadline=first['expiresAt']
+  if type(deadline) is not int or not 0 < deadline-int(time.time()*1000) <= 900000:raise ValueError()
+  m=Marionette(host='127.0.0.1',port=2828,socket_timeout=12);m.start_session(timeout=8);m.timeout.script=8
+  select_live_chrome_window(m)
+  ext=ensure_extension(m)
+  def environment_ok():
+   select_live_chrome_window(m,getattr(provenance,'_owner',None))
+   with m.using_context('chrome'):
+    env=m.execute_script("return Services.policies.getActivePolicies()?.['3rdparty']?.Extensions?.[arguments[0]]?.environment||null;",script_args=[ADDON_ID])
+   return valid_environment(env,expected)
+  if not environment_ok() or pending(m,ext):raise ValueError()
+  provenance=PopupProvenance(m,ext,expires_at=deadline)
+  provenance.arm()
+  # Settle native attachment before any website credential request is permitted.
+  time.sleep(3)
+  if pending(m,ext,getattr(provenance,'_owner',None)):raise ValueError()
+  emit(ident,'armed',{'ok':True,'state':'armed'})
+  while True:
+   q=line();ident=q.get('id')
+   if q=={'action':'release'}:break
+   action=q.get('action')
+   if not select_request_context(m,provenance,action,ident):
+    if action in {'status','approve'}:continue
+    raise ValueError()
+   if action=='status':
+    if set(q)!={'id','action'}:raise ValueError()
+    pending_value=pending_status(m,ext,getattr(provenance,'_owner',None))
+    if pending_value.get('ok') is not True:
+     emit(ident,'final',pending_value);continue
+    if pending_value.get('state')=='passkey_pending':value=pending_value
+    else:
+     surface=ToolbarPopup(m);opened=False
+     try:
+      if not surface.present():surface.open();opened=True
+      state,_=wait_state(surface);value=bw_result(state,state!='unknown','extension_unavailable' if state=='unknown' else None)
+     finally:
+      if opened:surface.close()
+    emit(ident,'final',value);continue
+   if action!='approve' or set(q)-{'id','action','binding','accountHint','expectedServerOrigin'}:raise ValueError()
+   binding=q.get('binding')
+   if not isinstance(binding,dict) or set(binding)!={'url','frameId'} or q.get('expectedServerOrigin')!=expected:raise ValueError()
+   if q.get('accountHint') is not None and (not isinstance(q['accountHint'],str) or not q['accountHint'] or len(q['accountHint'])>512):raise ValueError()
+   try:
+    p,digest=policy()
+    select_live_chrome_window(m,getattr(provenance,'_owner',None))
+    if ensure_extension(m)!=ext or not environment_ok():value=reject('prompt_mismatch')
+    else:
+     bound={**binding,'extensionUuid':ext};value=inspect_get(m,bound,p,q.get('accountHint'),provenance=provenance)
+     if value.get('ok') is True and value.get('state')=='ready':
+      value['policyHash']=digest;emit(ident,'prepared',value)
+      decision=line()
+      if decision=={'action':'release'}:break
+      if set(decision)!={'id','decision'} or decision['id']!=ident or decision['decision'] not in {'approve','reject'}:raise ValueError()
+      if decision['decision']=='reject':value=reject()
+      else:
+       current,new_hash=policy()
+       if new_hash!=digest:value=reject('policy_changed')
+       else:
+        select_live_chrome_window(m,getattr(provenance,'_owner',None))
+        if ensure_extension(m)!=ext or not environment_ok():value=reject('prompt_mismatch')
+        else:value=approve_get(m,{**bound,'sessionId':value['sessionId'],'rowFingerprint':value['rowFingerprint'],'rpId':value['rpId']},current,q.get('accountHint'),provenance=provenance)
+    if value.get('state')=='refused':value['state']='rejected'
+    emit(ident,'final',value)
+   except DriverError:emit(ident,'final',reject())
+   except PolicyError:emit(ident,'final',reject('policy_invalid'))
+ except Exception:
+  if ident is not None:
+   try:emit(ident,'error',reject())
+   except Exception:pass
+ finally:
+  if provenance is not None:
+   try:provenance.close()
+   except Exception:pass
+  if m is not None:
+   try:m.delete_session()
+   except Exception:pass
+if __name__=='__main__':main()
