+[Unit]
+Description=Owner-authorized Bitwarden extension delivery for opaque operation %i
+After=docker.service
+Requires=docker.service
+ConditionPathExists=/run/camofox-extension-broker/requests/%i.json
+
+[Service]
+Type=oneshot
+User=camofox
+Group=camofox
+UMask=0077
+# Existing source verified by unit metadata; this candidate never reads it.
+LoadCredentialEncrypted=vault-unlock:/etc/credstore.encrypted/collector-vault/unlock.cred
+ExecStart=/usr/bin/python3 /opt/camofox-extension-broker/vaultwarden-deliver.py --operation-id %i
+TimeoutStartSec=80
+NoNewPrivileges=yes
+PrivateTmp=yes
+ProtectHome=yes
+ProtectSystem=strict
+RestrictAddressFamilies=AF_UNIX
+ReadWritePaths=/run/camofox-extension-broker/requests
+StandardOutput=journal
+StandardError=null
diff --git a/plugins/bitwarden-unlock/driver.py b/plugins/bitwarden-unlock/driver.py
new file mode 100644
index 0000000..c2e0277
--- /dev/null
+++ b/plugins/bitwarden-unlock/driver.py
@@ -0,0 +1,503 @@
+#!/usr/bin/env python3
+"""Single-attempt Bitwarden driver. Private stdin in; typed state only out.
+
+The Node broker owns serialization, cancellation, and the total deadline. This
+helper never logs popup text, passwords, account names, exception messages, or
+stack traces. It never selects an arbitrary extension/profile directory.
+"""
+import json
+import hashlib
+import os
+import sys
+import time
+import uuid
+from urllib.parse import urlsplit
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "pylibs"))
+ADDON_ID = "{446900e4-71c2-419f-a6a7-df9c091e268b}"
+ADDON_VERSION = "2026.7.0"
+ADDON_XPI = "/opt/camofox-cache/camoufox/distribution/bitwarden_password_manager-2026.7.0.xpi"
+ADDON_SHA256 = "11836eb9d2abc9914bb337b57e20c5a09cf44f24fa572f7e886384fd350a5112"
+MAX_MESSAGE = 16384
+LOGIN_MASTER_SELECTOR = '[data-testid="login-master-password-input"]'
+LOCKED_MASTER_SELECTOR = 'input[name="masterPassword"][type="password"]'
+LOGIN_SUBMIT_SELECTOR = '[data-testid="login-submit-button"]:not([disabled])'
+LOCKED_SUBMIT_SELECTOR = 'bit-lock button[type="submit"]:not([disabled])'
+STATES = {"locked", "logged_out", "login_start", "unlocked", "two_factor_required", "invalid_master_password", "unknown", "unavailable", "lock_failed"}
+
+from extension_contract import account_matches, valid_environment
+
+INVENTORY_JS = """
+const visible = el => {const r=el.getBoundingClientRect(),s=getComputedStyle(el);
+ return r.width>0&&r.height>0&&s.display!=='none'&&s.visibility!=='hidden';};
+const routePrefix='/'+(location.hash.split('?')[0].replace(/^#/,'').split('/').filter(Boolean).join('/')).toLowerCase();
+const twoFactorStep=routePrefix==='/2fa'||!!document.querySelector('app-two-factor-auth');
+return {routePrefix,twoFactorStep,bodyText:(document.body?.innerText||'').slice(0,4000),
+ inputs:[...document.querySelectorAll('input')].filter(visible).map(el=>({
+ type:el.type,name:el.name,autocomplete:el.autocomplete})),
+ accountLabels:[...document.querySelectorAll('app-current-account button > span.tw-sr-only')]
+  .filter(visible).map(el=>(el.textContent||'').trim()),
+ buttons:[...document.querySelectorAll('button,[role="button"],a')].filter(visible)
+ .map(el=>(el.innerText||el.textContent||'').trim())};
+"""
+CLICK_JS = """
+const patterns=arguments[0].map(p=>new RegExp(p,'i'));
+const visible=el=>{const r=el.getBoundingClientRect(),s=getComputedStyle(el);
+ return r.width>0&&r.height>0&&s.display!=='none'&&s.visibility!=='hidden';};
+const bs=[...document.querySelectorAll('button,[role="button"],a')].filter(visible);
+for(const p of patterns){const b=bs.find(el=>!el.disabled&&p.test((el.innerText||el.textContent||'').trim()));
+ if(b){b.click();return true;}}return false;
+"""
+
+
+class DriverError(Exception):
+    def __init__(self, code):
+        self.code = code
+        super().__init__(code)
+
+
+def classify(inv):
+    if inv.get("twoFactorStep") is True:
+        return "two_factor_required"
+    text = str(inv.get("bodyText", "")).lower()
+    inputs = inv.get("inputs") or []
+    has_email = any(i.get("type") == "email" or "mail" in str(i.get("autocomplete", "")) for i in inputs)
+    has_password = any(i.get("type") == "password" for i in inputs)
+    if any(marker in text for marker in ["incorrect master password", "invalid master password", "too many invalid"]):
+        return "invalid_master_password"
+    if any(marker in text for marker in ["my vault", "all items", "new item", "generator"]) and not has_password and not has_email:
+        return "unlocked"
+    if has_password and not has_email and "unlock" in text:
+        return "locked"
+    if has_email or has_password:
+        return "logged_out"
+    if "log in" in text or "email address" in text or "create account" in text:
+        return "login_start"
+    return "unknown"
+
+
+def result(state, ok=True, error_code=None):
+    return {"ok": ok, "state": state, **({"errorCode": error_code} if error_code else {})}
+
+
+def extension_policy(m):
+    with m.using_context("chrome"):
+        return m.execute_async_script("""
+const id=arguments[0],done=arguments[arguments.length-1],p=WebExtensionPolicy.getByID(id);
+if(!p){done(null);return;}
+const {AddonManager}=ChromeUtils.importESModule('resource://gre/modules/AddonManager.sys.mjs');
+AddonManager.getAddonByID(id).then(a=>done(a?{id:p.id,uuid:p.mozExtensionHostname,
+ version:a.version,active:a.isActive,signedState:a.signedState}:null),()=>done(null));
+""", script_args=[ADDON_ID])
+
+
+def addon_package_matches():
+    digest = hashlib.sha256()
+    try:
+        with open(ADDON_XPI, "rb") as package:
+            for chunk in iter(lambda: package.read(1024 * 1024), b""):
+                digest.update(chunk)
+    except OSError:
+        return False
+    return digest.hexdigest() == ADDON_SHA256
+
+
+def valid_extension_policy(policy):
+    return bool(policy and policy.get("id") == ADDON_ID and policy.get("uuid")
+                and policy.get("version") == ADDON_VERSION and policy.get("active") is True
+                and policy.get("signedState") == 2)
+
+
+def ensure_extension(m):
+    # Enterprise policy is the sole installation authority. A driver may only
+    # observe the pinned package becoming active, never install/reinstall it.
+    if not addon_package_matches():
+        raise DriverError("extension_unavailable")
+    deadline = time.monotonic() + 10
+    while time.monotonic() < deadline:
+        try:
+            policy = extension_policy(m)
+        except Exception:
+            policy = None
+        if valid_extension_policy(policy):
+            return policy["uuid"]
+        if policy and (policy.get("id") != ADDON_ID or not policy.get("uuid")
+                       or policy.get("version") != ADDON_VERSION or policy.get("signedState") != 2):
+            # A mismatched or unsigned existing addon is not a startup delay.
+            raise DriverError("extension_unavailable")
+        remaining = deadline - time.monotonic()
+        if remaining > 0:
+            time.sleep(min(0.25, remaining))
+    raise DriverError("extension_unavailable")
+
+
+def inventory(surface):
+    return surface.execute(INVENTORY_JS)
+
+
+def wait_state(surface, attempts=30, delay=0.5, stop=None):
+    inv = {"bodyText": "", "inputs": []}
+    for _ in range(attempts):
+        try:
+            inv = inventory(surface)
+            state = classify(inv)
+            if (stop and state in stop) or (not stop and state != "unknown"):
+                return state, inv
+        except Exception:
+            pass
+        time.sleep(delay)
+    return classify(inv), inv
+
+
+def click(surface, patterns):
+    return surface.execute(CLICK_JS, [patterns]) is True
+
+
+def verify_managed_server(surface, origin):
+    """Require packaged managed storage before accepting any master password.
+
+    Failure to read an enterprise environment is a hard stop, not a fallback to
+    bitwarden.com. This does not inspect or export account/vault storage.
+    """
+    env = surface.execute("""
+const done=arguments[arguments.length-1];
+const api=window.browser||window.wrappedJSObject?.browser;
+if(!api?.storage?.managed){done(false);return;}
+api.storage.managed.get().then(data=>{
+ const env=data.environment; if(!env){done(false);return;}
+ if(typeof env!=='object'||Array.isArray(env)){done(false);return;}
+ const keys=Object.keys(env);if(keys.length>16){done({__unknownFields:true});return;}
+ const bounded={};
+ for(const key of keys){
+  if(typeof key!=='string'||key.length>64){done({__unknownFields:true});return;}
+  const value=env[key];
+  if(typeof value==='string'&&value.length>2048){done({__oversizedValue:true});return;}
+  bounded[key]=typeof value==='string'?value:null;
+ }
+ done(bounded);
+}).catch(()=>done(false));
+""", asynchronous=True)
+    return valid_environment(env, origin)
+
+
+def open_account_menu(surface):
+    return surface.execute("""
+const button=document.querySelector('app-current-account button');
+if(!button)return false;button.click();return true;
+""") is True
+
+
+def begin_lock_reload(surface):
+    """Watch Firefox lifecycle metadata without retaining the old key-bearing context."""
+    surface._chrome()
+    m = surface.m
+    handle = m.current_chrome_window_handle
+    key = "__camofox_bitwarden_reload_" + uuid.uuid4().hex
+    captured = m.execute_script("""
+const p=WebExtensionPolicy.getByID(arguments[0]),key=arguments[1];
+const context=p?.extension?.backgroundContext;
+if(!p||!context||context.unloaded||p.extension.backgroundState!=='running')return false;
+Object.defineProperty(window,key,{configurable:true,value:{
+ policy:new WeakRef(p),context:new WeakRef(context),transition:false}});
+return true;
+""", script_args=[ADDON_ID, key])
+    return {"windowHandle": handle, "key": key} if captured is True else None
+
+
+def lock_reload_status(surface, watch):
+    m = surface.m
+    m.set_context("chrome")
+    m.switch_to_window(watch["windowHandle"], focus=False)
+    m.switch_to_frame()
+    return m.execute_async_script("""
+const id=arguments[0],key=arguments[1],widgetId=arguments[2],done=arguments[arguments.length-1];
+const watch=window[key];if(!watch){done(null);return;}
+const p=WebExtensionPolicy.getByID(id),context=p?.extension?.backgroundContext;
+const running=!!p&&p.extension.backgroundState==='running'&&!!context&&!context.unloaded;
+if(!running||p!==watch.policy.deref()||context!==watch.context.deref())watch.transition=true;
+const {AddonManager}=ChromeUtils.importESModule('resource://gre/modules/AddonManager.sys.mjs');
+AddonManager.getAddonByID(id).then(a=>done(a&&p?{
+ id:p.id,uuid:p.mozExtensionHostname,version:a.version,active:a.isActive,
+ signedState:a.signedState,running,transition:watch.transition,
+ widgetPresent:!!document.getElementById(widgetId)}:null),()=>done(null));
+""", script_args=[ADDON_ID, watch["key"],
+        "_446900e4-71c2-419f-a6a7-df9c091e268b_-browser-action"])
+
+
+def wait_lock_reload(surface, watch, timeout_seconds=12):
+    # Default master-password-only profiles reload their extension process on
+    # lock. PIN/biometric configurations that suppress reload are not accepted
+    # by this candidate: no observed transition means an uncertain lock.
+    deadline = time.monotonic() + timeout_seconds
+    while time.monotonic() < deadline:
+        try:
+            metadata = lock_reload_status(surface, watch)
+            if (valid_extension_policy(metadata) and metadata.get("running") is True
+                    and metadata.get("transition") is True and metadata.get("widgetPresent") is True):
+                return True
+        except Exception:
+            pass
+        time.sleep(0.1)
+    return False
+
+
+def end_lock_reload(surface, watch):
+    if not watch:
+        return
+    try:
+        m = surface.m
+        m.set_context("chrome")
+        m.switch_to_window(watch["windowHandle"], focus=False)
+        m.switch_to_frame()
+        m.execute_script("delete window[arguments[0]];", script_args=[watch["key"]])
+    except Exception:
+        # Weak references cannot keep the old background/vault alive if its
+        # Firefox window disappeared before bookkeeping could be removed.
+        pass
+
+
+def lock_extension(surface, state):
+    if state in ("locked", "logged_out", "login_start"):
+        return result(state)
+    watch = None
+    try:
+        watch = begin_lock_reload(surface)
+        if not watch:
+            return result("lock_failed", False, "lock_failed")
+        action_sent = False
+        try:
+            lock_actions = [r"^lock all$", r"^lock now$"]
+            action_sent = click(surface, lock_actions)
+            if not action_sent and open_account_menu(surface):
+                for _ in range(20):
+                    if click(surface, lock_actions):
+                        action_sent = True
+                        break
+                    time.sleep(0.25)
+        except Exception:
+            # A click may already have committed. Never send it again.
+            action_sent = False
+        # Bitwarden waits for all UI views to close before runtime.reload().
+        # Reopening here would obstruct that security-related process reload.
+        surface.close()
+        if not action_sent or not wait_lock_reload(surface, watch):
+            return result("lock_failed", False, "lock_failed")
+        # This is a single observation of the new extension generation; it
+        # never installs/reloads the addon or repeats the lock action.
+        surface.open()
+        state, _ = wait_state(surface, attempts=20, delay=0.25,
+                              stop={"locked", "logged_out", "login_start"})
+        if state not in ("locked", "logged_out", "login_start"):
+            return result("lock_failed", False, "lock_failed")
+        return result(state)
+    except Exception:
+        return result("lock_failed", False, "lock_failed")
+    finally:
+        end_lock_reload(surface, watch)
+
+
+def unlock_extension(surface, state, inv, req, on_secret_filled=None, on_popup_reopened=None):
+    if state == "unlocked":
+        # A broker may not silently acquire an already-open global vault.
+        return result("unlocked", False, "account_mismatch")
+    if not verify_managed_server(surface, req["expectedServerOrigin"]):
+        return result(state, False, "server_mismatch")
+    if state == "two_factor_required" or inv.get("twoFactorStep") is True:
+        return result("two_factor_required", False, "two_factor_required")
+    email = req.get("email")
+    email_stage_entered = False
+    inputs = inv.get("inputs", [])
+    has_email_input = any(i.get("type") == "email" for i in inputs)
+    has_password_input = any(i.get("type") == "password" for i in inputs)
+    if state == "locked" or (has_password_input and not has_email_input):
+        # An existing password-only form must identify its current account.
+        labels = inv.get("accountLabels") or []
+        if not email or not any(account_matches(label, email) for label in labels):
+            return result(state, False, "account_mismatch")
+    if state == "login_start":
+        if not click(surface, [r"^log in$", r"^log in with master password$"]):
+            return result(state, False, "driver_failed")
+        time.sleep(0.5)
+        try:
+            surface.close()
+            if on_popup_reopened is not None:
+                on_popup_reopened()
+            surface.open()
+        except Exception:
+            return result(state, False, "driver_failed")
+        surface.execute("""
+const skip=document.querySelector('#default-password-manager-prompt_button_skip-for-now');
+if(!skip)return false;skip.click();return true;
+""")
+        state, inv = wait_state(surface)
+    if state == "two_factor_required" or inv.get("twoFactorStep") is True:
+        return result("two_factor_required", False, "two_factor_required")
+    if any(i.get("type") == "email" for i in inv.get("inputs", [])):
+        if not email:
+            return result(state, False, "account_mismatch")
+        try:
+            surface.fill('input[type="email"]', email)
+        except Exception:
+            return result(state, False, "driver_failed")
+        if not click(surface, [r"^continue$"]):
+            return result(state, False, "driver_failed")
+        email_stage_entered = True
+        state, inv = wait_state(surface, attempts=25, stop={"locked", "logged_out", "unlocked", "two_factor_required"})
+        # A password-shaped YubiKey challenge is still 2FA. Observe the
+        # structural step before considering any master-password field.
+        for _ in range(25):
+            if state == "two_factor_required" or inv.get("twoFactorStep") is True:
+                return result("two_factor_required", False, "two_factor_required")
+            if any(i.get("type") == "password" for i in inv.get("inputs", [])):
+                break
+            time.sleep(0.3)
+            inv = inventory(surface)
+            state = classify(inv)
+        else:
+            if state == "two_factor_required":
+                return result(state, False, state)
+            return result(state, False, "driver_failed")
+    # Recheck after intro/email transitions; an existing password screen must
+    # identify its account unless this request entered the preceding email step.
+    labels = inv.get("accountLabels") or []
+    if not email or (labels and not all(account_matches(label, email) for label in labels)):
+        return result(state, False, "account_mismatch")
+    if not email_stage_entered and not any(account_matches(label, email) for label in labels):
+        return result(state, False, "account_mismatch")
+    if state == "two_factor_required" or inv.get("twoFactorStep") is True:
+        return result("two_factor_required", False, "two_factor_required")
+    password_selector = LOCKED_MASTER_SELECTOR if state == "locked" else LOGIN_MASTER_SELECTOR
+    submit_selector = LOCKED_SUBMIT_SELECTOR if state == "locked" else LOGIN_SUBMIT_SELECTOR
+    if on_secret_filled is not None:
+        on_secret_filled()
+    try:
+        surface.fill(password_selector, req["masterPassword"])
+    except Exception:
+        return result(state, False, "driver_failed")
+    # A failed click may have reached the page; never retry an uncertain submit.
+    try:
+        surface.click(submit_selector)
+    except Exception:
+        return result(state, False, "driver_failed")
+    state, _ = wait_state(surface, attempts=35, stop={"unlocked", "invalid_master_password", "two_factor_required"})
+    if state == "unlocked":
+        return result(state)
+    if state in ("invalid_master_password", "two_factor_required"):
+        return result(state, False, state)
+    return result(state, False, "driver_failed")
+
+
+def run(req, marionette_factory=None):
+    action = req.get("action")
+    if action not in ("status", "unlock", "lock"):
+        return result("unavailable", False, "unsupported_action")
+    keep_human_ui = req.get("keepHumanUI", False)
+    if not isinstance(keep_human_ui, bool) or (keep_human_ui and action != "status"):
+        return result("unavailable", False, "invalid_request")
+    if action == "unlock" and (not isinstance(req.get("masterPassword"), str) or not req["masterPassword"]):
+        return result("unavailable", False, "invalid_request")
+    if marionette_factory is None:
+        from marionette_driver.marionette import Marionette
+        marionette_factory = Marionette
+    m = marionette_factory(host="127.0.0.1", port=2828, socket_timeout=15)
+    from extension_surface import ToolbarPopup
+    surface = ToolbarPopup(m)
+    previous_handle, opened_by_us, keep_open, secret_exposed = None, False, keep_human_ui, False
+    cleanup_failed = False
+    response = result("unavailable", False, "driver_failed")
+    try:
+        m.start_session(timeout=10)
+        m.timeout.page_load = 15
+        m.timeout.script = 5
+        if keep_human_ui:
+            # During manual 2FA, status may only inspect an already-present
+            # toolbar popup. Never install, open, close, or refocus UI here.
+            if not valid_extension_policy(extension_policy(m)) or not surface.present():
+                response = result("two_factor_required", False, "two_factor_required")
+            else:
+                state, _ = wait_state(surface)
+                response = (result("two_factor_required", False, "two_factor_required")
+                            if state == "unknown" else result(state, True))
+        else:
+            ensure_extension(m)
+            handles = list(m.window_handles)
+            if handles:
+                try:
+                    previous_handle = m.current_window_handle
+                except Exception:
+                    # Extension first-run UI can change the selected window while
+                    # installation settles. Select an existing handle explicitly.
+                    previous_handle = handles[0]
+                    m.switch_to_window(previous_handle, focus=False)
+            was_open = surface.present()
+            if not was_open:
+                surface.open()
+                opened_by_us = True
+            state, inv = wait_state(surface)
+            if action == "status":
+                keep_open = state == "two_factor_required"
+                response = result(state, state != "unknown", "extension_unavailable" if state == "unknown" else None)
+            elif action == "lock":
+                opened_by_us = True
+                response = lock_extension(surface, state)
+            else:
+                def mark_secret_exposed():
+                    nonlocal secret_exposed
+                    secret_exposed = True
+                def mark_popup_reopened():
+                    nonlocal opened_by_us
+                    opened_by_us = True
+                response = unlock_extension(surface, state, inv, req,
+                                            on_secret_filled=mark_secret_exposed,
+                                            on_popup_reopened=mark_popup_reopened)
+                if response["state"] == "two_factor_required":
+                    keep_open = True
+    except DriverError as exc:
+        response = result("unavailable", False, exc.code)
+    except Exception:
+        response = result("unavailable", False, "driver_failed")
+    finally:
+        # Cleanup failure changes the response; a filled secret may never be
+        # reported as successfully handled while it could remain in the UI.
+        try:
+            if secret_exposed:
+                surface.execute("for(const el of document.querySelectorAll(arguments[0])){el.value='';el.dispatchEvent(new Event('input',{bubbles:true}));}", [LOGIN_MASTER_SELECTOR + ',' + LOCKED_MASTER_SELECTOR])
+            if opened_by_us and not keep_open:
+                surface.close()
+        except Exception:
+            cleanup_failed = True
+        try:
+            if not keep_open and previous_handle and previous_handle in m.window_handles:
+                m.switch_to_window(previous_handle)
+            m.delete_session()
+        except Exception:
+            cleanup_failed = True
+    if cleanup_failed:
+        return result("unavailable", False, "cleanup_failed")
+    return response
+
+
+def main():
+    try:
+        raw = sys.stdin.read(MAX_MESSAGE + 1)
+        if len(raw.encode("utf-8")) > MAX_MESSAGE:
+            raise ValueError()
+        req = json.loads(raw)
+        if not isinstance(req, dict) or set(req) - {"action", "email", "masterPassword", "expectedServerOrigin", "keepHumanUI"}:
+            raise ValueError()
+        if "keepHumanUI" in req and (not isinstance(req["keepHumanUI"], bool)
+                                      or req.get("action") != "status"):
+            raise ValueError()
+        origin = req.get("expectedServerOrigin", "")
+        parsed = urlsplit(origin)
+        if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password or parsed.path or parsed.query or parsed.fragment:
+            raise ValueError()
+        response = run(req)
+        req.clear()
+    except Exception:
+        response = result("unavailable", False, "invalid_request")
+    print(json.dumps(response), flush=True)
+
+
+if __name__ == "__main__":
+    main()
