+   * @openapi
+   * /bitwarden/operations/{operationId}:
+   *   get:
+   *     tags: [Browser]
+   *     summary: Read opaque unlock-operation state.
+   *     parameters:
+   *       - { name: operationId, in: path, required: true, schema: { type: string } }
+   *       - { name: userId, in: query, required: true, schema: { type: string } }
