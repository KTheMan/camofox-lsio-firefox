+
+
+ORIGIN = "https://login.example.test:9443"
+RP_ID = "example.test"
+ACCOUNT = "Alice@example.test"
+
+
+def policy_json(**overrides):
+    value = {"version": 1, "blockedOrigins": [], "blockedRpIds": [], "blockedAccounts": []}
+    value.update(overrides)
+    return json.dumps(value)
