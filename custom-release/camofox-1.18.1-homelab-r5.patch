diff --git a/lib/evaluate-timeout-recovery.js b/lib/evaluate-timeout-recovery.js
new file mode 100644
index 0000000..5404ee3
--- /dev/null
+++ b/lib/evaluate-timeout-recovery.js
@@ -0,0 +1,24 @@
+import { hasHumanControl, requestHumanControl } from './human-control.js';
+
+function recoveryError(code) {
+  const message = code === 'recovery_handoff_required'
+    ? 'Evaluation outcome is unknown; original tab preserved for human recovery.'
+    : 'Human control is already active; original tab preserved.';
+  return Object.assign(new Error(message), { statusCode: 409, code });
+}
+
+/** Preserve a timed-out evaluate tab and pause automation without replaying its code. */
+export function preserveEvaluationForHumanRecovery(tabState, {
+  tabStillOwned = false,
+  protectedElsewhere = false,
+} = {}) {
+  if (!tabStillOwned || protectedElsewhere) throw recoveryError('human_control_active');
+
+  if (!tabState?.humanControl || !hasHumanControl(tabState)) {
+    // A ready-to-resume lease was already explicitly completed; an unknown
+    // evaluation outcome needs a fresh lease and a fresh TTL.
+    requestHumanControl(tabState, { reason: 'manual' });
+  }
+
+  throw recoveryError('recovery_handoff_required');
+}
