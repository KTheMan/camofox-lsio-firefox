+    def test_rejects_symlink_or_untrusted_file_metadata(self):
+        with patch.object(os, "O_NOFOLLOW", 0x200000, create=True), \
+             patch.object(os, "open", side_effect=OSError("symlink refused")):
+            with self.assertRaises(PolicyError):
