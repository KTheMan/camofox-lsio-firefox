+#!/usr/bin/env python3
+"""Owner-only request trigger. Arguments and request file contain opaque IDs only."""
+import argparse
+import json
+import os
+from pathlib import Path
+import pwd
+import stat
+import subprocess
+import sys
+import uuid
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--operation-id", required=True)
+    parser.add_argument("--browser-instance", required=True)
+    args = parser.parse_args()
+    request_path = None
+    created_by_us = False
+    try:
+        if os.getuid() != pwd.getpwnam("camofox").pw_uid:
+            raise ValueError()
+        values = {"operationId": args.operation_id, "browserInstance": args.browser_instance}
+        if any(
+            (parsed := uuid.UUID(value)).version != 4
+            or parsed.variant != uuid.RFC_4122
+            or str(parsed) != value
+            for value in values.values()
+        ):
+            raise ValueError()
+        directory = Path("/run/camofox-extension-broker/requests")
+        info = directory.lstat()
+        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) & 0o077:
+            raise ValueError()
+        request_path = directory / (args.operation_id + ".json")
+        fd = os.open(request_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+        created_by_us = True
+        with os.fdopen(fd, "w", encoding="utf-8") as stream:
+            json.dump(values, stream)
+        proc = subprocess.run(["/usr/bin/systemctl", "start", "camofox-extension-unlock@" + args.operation_id + ".service"],
+                              stdin=subprocess.DEVNULL, capture_output=True, timeout=80, check=False)
+        if proc.returncode:
+            raise ValueError()
+        print(json.dumps({"ok": True, "operationId": args.operation_id, "state": "delivered_check_operation"}), flush=True)
+        return 0
+    except Exception:
+        if request_path and created_by_us:
+            try:
+                request_path.unlink()
+            except OSError:
+                pass
+        print(json.dumps({"ok": False, "errorCode": "owner_delivery_setup_required"}), flush=True)
+        return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
