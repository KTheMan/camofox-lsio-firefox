diff --git a/lib/private-screenshot.js b/lib/private-screenshot.js
new file mode 100644
index 0000000..10d1048
--- /dev/null
+++ b/lib/private-screenshot.js
@@ -0,0 +1,11 @@
+// Native screenshot masks avoid changing DOM values or interrupting human input.
+// Mask all editable controls: field metadata alone cannot identify every secret.
+export const PRIVATE_SCREENSHOT_SELECTOR = 'input:not([type="button"]):not([type="submit"]):not([type="reset"]):not([type="checkbox"]):not([type="radio"]):not([type="image"]), textarea, select, [contenteditable]';
+
+export function privateScreenshot(page, options = {}) {
+  return page.screenshot({
+    ...options,
+    mask: page.frames().map(frame => frame.locator(PRIVATE_SCREENSHOT_SELECTOR)),
+    maskColor: '#FF00FF',
+  });
+}
