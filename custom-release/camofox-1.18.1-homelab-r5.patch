+import test from 'node:test';import assert from 'node:assert/strict';import {EventEmitter} from 'node:events';import {PassThrough} from 'node:stream';
+import {createPasskeyTransport} from './passkey-transport.js';
+const ready={ok:true,state:'ready',sessionId:'11111111-1111-4111-8111-111111111111',rowFingerprint:'a'.repeat(64),policyHash:'b'.repeat(64),rpId:'extension.test',senderTabId:1};
+const delay=ms=>new Promise(r=>setTimeout(r,ms));
+function fixture({holdRelease=false}={}){
+ let child,spawned=0;const sent=[];
+ const spawnWorker=()=>{
+  spawned++;child=new EventEmitter();child.stdin=new PassThrough();child.stdout=new PassThrough();child.kill=()=>true;
+  let pending;child.reply=(id,phase,result)=>child.stdout.write(JSON.stringify({id,phase,result})+'\n');
+  child.stdin.on('data',chunk=>{for(const line of chunk.toString().trim().split('\n')){const q=JSON.parse(line);sent.push(q);if(q.action==='arm')child.reply(q.id,'armed',{ok:true,state:'armed'});if(q.action==='approve'){pending=q;child.reply(q.id,'prepared',ready)}if(q.decision==='approve')child.reply(q.id,'final',{ok:true,state:'approval_sent'});if(q.action==='status')child.reply(q.id,'final',{ok:true,state:'unlocked'});if(q.action==='release'&&!holdRelease)setImmediate(()=>child.emit('close',0));}});return child;
+ };
+ return{spawnWorker,sent,get child(){return child},get spawned(){return spawned}};
+}
+const config={expectedServerOrigin:'https://vault.extension.test',expiresAt:Date.now()+300000},request={action:'approve',binding:{url:'https://rp.extension.test/',frameId:'mainframe-1'},expectedServerOrigin:'https://vault.extension.test'};
+test('one armed worker handles repeated commands, no new native session',async()=>{
+ const f=fixture(),t=createPasskeyTransport({spawnWorker:f.spawnWorker}),a=new AbortController();await t.arm(config,{signal:a.signal});
+ for(let i=0;i<2;i++){const r=await t(request,{signal:a.signal,onPrepared:async()=>({decision:'approve'})});assert.equal(r.state,'approval_sent')}
+ assert.equal(f.sent.find(x=>x.action==='arm').expiresAt,config.expiresAt);assert.equal((await t.status()).state,'unlocked');assert.equal(f.spawned,1);assert.equal(f.sent.filter(x=>x.decision==='approve').length,2);await t.release();
+});
+test('timeout forbids late permit even while child kill/exit delayed',async()=>{
+ const f=fixture({holdRelease:true}),t=createPasskeyTransport({spawnWorker:f.spawnWorker,commandTimeoutMs:10,releaseTimeoutMs:200}),a=new AbortController();await t.arm(config,{signal:a.signal});
+ let decide,entered;const inside=new Promise(r=>entered=r);const p=t(request,{signal:a.signal,onPrepared:()=>{entered();return new Promise(r=>decide=r)}});await inside;await delay(25);decide({decision:'approve'});await delay(5);
+ assert.equal(f.sent.filter(x=>x.decision==='approve').length,0);f.child.emit('close',0);assert.equal((await p).ok,false);await t.release();
+});
+test('child error is not proof of exit; release waits for actual close',async()=>{
+ const f=fixture({holdRelease:true}),t=createPasskeyTransport({spawnWorker:f.spawnWorker,releaseTimeoutMs:200});await t.arm(config,{});f.child.emit('error',new Error('synthetic'));
+ let released=false;const p=t.release().then(()=>released=true);await delay(10);assert.equal(released,false);f.child.emit('close',0);await p;assert.equal(released,true);
+});
+test('abort closes worker before allowing a replacement arm',async()=>{
+ const f=fixture(),t=createPasskeyTransport({spawnWorker:f.spawnWorker}),a=new AbortController();await t.arm(config,{signal:a.signal});a.abort();await t.release();const b=new AbortController();await t.arm(config,{signal:b.signal});assert.equal(f.spawned,2);await t.release();
+});
