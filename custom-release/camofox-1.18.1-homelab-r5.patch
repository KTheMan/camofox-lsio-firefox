+/** Bitwarden browser-scope control. Credentials never enter this HTTP API. */
+import { createBitwardenBroker, BrokerError, browserWindowDriver } from './runtime.js';
+
+function body(req) {
+  const value = req.body || {};
+  if (!value || Array.isArray(value) || typeof value !== 'object') throw new BrokerError('invalid_request', 400);
+  // Reject, rather than silently discard, attempts to use the retired secret API.
+  if (Object.keys(value).some((key) => !['userId', 'ttlSeconds', 'operationId'].includes(key))) throw new BrokerError('unsupported_field', 400);
+  return value;
+}
+function userId(value) {
+  if (typeof value !== 'string' || !value.trim() || value.length > 128) throw new BrokerError('user_id_required', 400);
+  return value;
+}
