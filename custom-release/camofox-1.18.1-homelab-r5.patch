+
+class PolicySchemaTests(unittest.TestCase):
+    def test_explicit_empty_default_is_default_allow(self):
+        policy = load_policy(DEFAULT_POLICY_JSON)
+        self.assertEqual(policy, ApprovalPolicy(frozenset(), frozenset(), frozenset()))
+        self.assertFalse(is_blocked(policy, {"origin": ORIGIN, "rpId": RP_ID, "account": ACCOUNT}))
+
+    def test_missing_policy_is_not_silently_defaulted(self):
+        for raw in (None, b"", ""):
+            with self.subTest(raw=raw), self.assertRaises(PolicyError):
+                load_policy(raw)
+
+    def test_rejects_duplicate_json_keys_unknown_fields_and_duplicate_values(self):
+        cases = [
+            '{"version":1,"version":1,"blockedOrigins":[],"blockedRpIds":[],"blockedAccounts":[]}',
+            policy_json(extra="ignored"),
+            policy_json(version=True),
+            policy_json(blockedOrigins=[ORIGIN, ORIGIN]),
+            policy_json(blockedAccounts=["Alice@example.test", " alice@EXAMPLE.test "]),
+            policy_json(blockedCipherIds=["aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"]),
+            policy_json(blockedOrigins=["https://*.example.test"]),
+            policy_json(blockedRpIds=["*.example.test"]),
+        ]
+        for raw in cases:
+            with self.subTest(raw=raw), self.assertRaises(PolicyError):
+                load_policy(raw)
+
+    def test_rejects_noncanonical_or_unsafe_origins_and_rp_ids(self):
+        for origin in (
+            "http://login.example.test",
+            "https://User@login.example.test",
+            "https://login.example.test/path",
+            "https://login.example.test?x=1",
+            "https://login.example.test:443",
+            "https://LOGIN.example.test",
+            "https://login.example.test:09443",
+            "https://login.example.test.",
+            "https://login.example.test%40evil.test",
+        ):
+            with self.subTest(origin=origin), self.assertRaises(PolicyError):
+                load_policy(policy_json(blockedOrigins=[origin]))
+        for rp_id in ("EXAMPLE.test", "example.test.", "localhost", "*.example.test", "evil_test.example"):
+            with self.subTest(rp_id=rp_id), self.assertRaises(PolicyError):
+                load_policy(policy_json(blockedRpIds=[rp_id]))
+
+    def test_policy_size_is_bounded(self):
+        with self.assertRaises(PolicyError):
+            load_policy(b" " * 65537)
+
+
+class DenyEvaluationTests(unittest.TestCase):
+    def test_origin_deny_is_exact_and_preserves_nondefault_port(self):
+        policy = load_policy(policy_json(blockedOrigins=[ORIGIN]))
+        self.assertTrue(is_blocked(policy, {"origin": ORIGIN, "rpId": RP_ID}))
+        self.assertFalse(is_blocked(policy, {"origin": "https://login.example.test", "rpId": RP_ID}))
+        self.assertFalse(is_blocked(policy, {"origin": "https://other.example.test:9443", "rpId": RP_ID}))
+
+    def test_rp_id_block_applies_to_exact_domain_and_subdomains_not_lookalikes(self):
+        policy = load_policy(policy_json(blockedRpIds=["example.test"]))
+        self.assertTrue(is_blocked(policy, {"origin": ORIGIN, "rpId": "example.test"}))
+        self.assertTrue(is_blocked(policy, {"origin": "https://a.b.example.test", "rpId": "example.test"}))
+        self.assertFalse(is_blocked(policy, {"origin": "https://badexample.test", "rpId": "badexample.test"}))
+
+    def test_blocked_account_is_exact_after_space_and_case_normalization(self):
+        policy = load_policy(policy_json(blockedAccounts=[" Alice\n  Example@TEST "]))
+        self.assertTrue(is_blocked(policy, {"origin": ORIGIN, "rpId": RP_ID, "account": "alice example@test"}))
+        self.assertFalse(is_blocked(policy, {"origin": ORIGIN, "rpId": RP_ID, "account": "alice@example.test"}))
+        with self.assertRaises(PolicyError):
+            is_blocked(policy, {"origin": ORIGIN, "rpId": RP_ID})
+
+    def test_invalid_or_mismatched_binding_fails_closed(self):
+        policy = load_policy(DEFAULT_POLICY_JSON)
+        bad = [
+            {"origin": ORIGIN, "rpId": "evil.test"},
+            {"origin": "http://login.example.test", "rpId": RP_ID},
+            {"origin": ORIGIN, "rpId": RP_ID, "extra": "x"},
+            {"origin": ORIGIN, "rpId": RP_ID, "account": "   "},
+            {"origin": ORIGIN},
+        ]
+        for observation in bad:
+            with self.subTest(observation=observation), self.assertRaises(PolicyError):
+                is_blocked(policy, observation)
+
+
+class TrustedFileTests(unittest.TestCase):
+    def test_loads_only_regular_private_single_link_file_from_allowed_owner(self):
+        raw = DEFAULT_POLICY_JSON
+        fd = 44
+        info = SimpleNamespace(st_mode=stat.S_IFREG | 0o640, st_size=len(raw),
+                               st_uid=1234, st_nlink=1)
+        reads = [raw, b""]
+        with patch.object(os, "O_NOFOLLOW", 0x200000, create=True), \
+             patch.object(os, "open", return_value=fd) as open_file, \
+             patch.object(os, "fstat", return_value=info), \
+             patch.object(os, "getuid", return_value=1234, create=True), \
+             patch.object(os, "read", side_effect=lambda _fd, _size: reads.pop(0)), \
+             patch.object(os, "close"):
+            self.assertEqual(load_policy_file("/fixed/host-policy.json"), load_policy(raw))
+        self.assertEqual(open_file.call_args.args[0], "/fixed/host-policy.json")
