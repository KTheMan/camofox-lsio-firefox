+"""Short-lived native Firefox popup provenance observer.
+
+The observer is installed in a browser-chrome window before a website can
+request a passkey. It records committed native FIDO popup URLs and primitive
+browsing-context/document identifiers. It never injects into content or
+changes routing/history.
+"""
+from __future__ import annotations
+
+import re
+import secrets
+import time
+import hashlib
+from urllib.parse import urlsplit
+
+
