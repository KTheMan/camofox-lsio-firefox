--- /dev/null
+++ b/plugins/bitwarden-unlock/extension_surface.py
@@ -0,0 +1,161 @@
+"""Version-pinned DOM bridge to the real Firefox toolbar popup.
+
+Only trusted driver code supplies scripts; this is never an HTTP/MCP evaluator.
+The pinned Firefox build cannot switch WebDriver frames into remote XUL browsers,
+so its own Marionette actor runs normal DOM operations in the actual popup.
+"""
+import time
+
+ADDON_ID = '{446900e4-71c2-419f-a6a7-df9c091e268b}'
+WIDGET_ID = '_446900e4-71c2-419f-a6a7-df9c091e268b_-browser-action'
+FIND = """
+const p=WebExtensionPolicy.getByID(arguments[0]);
+if(!p)return null;
+const prefix='moz-extension://'+p.mozExtensionHostname+'/popup/index.html';
+const matches=[...document.querySelectorAll('browser.webextension-popup-browser')]
+ .filter(b=>b.currentURI?.spec.split(/[?#]/)[0]===prefix&&b.closest('panel')?.state==='open'
+   &&b.getBoundingClientRect().width>0&&b.getBoundingClientRect().height>0);
+if(matches.length!==1)return null;
+return matches[0];
+"""
+
+
+class SurfaceError(Exception):
+    pass
+
+
+class ToolbarPopup:
+    def __init__(self, marionette):
+        self.m = marionette
+
+    def _chrome(self):
+        self.m.set_context('chrome')
+        normal = "return window.toolbar?.visible === true && !!document.getElementById(arguments[0]);"
+        try:
+            self.m.switch_to_frame()
+            if self.m.execute_script(normal, script_args=[WIDGET_ID]) is True:
+                return
+        except Exception:
+            pass
+        matches = []
+        for handle in self.m.chrome_window_handles:
+            try:
+                self.m.switch_to_window(handle, focus=False)
+                self.m.switch_to_frame()
+                if self.m.execute_script(normal, script_args=[WIDGET_ID]) is True:
+                    matches.append(handle)
+            except Exception:
+                continue
+        if len(matches) != 1:
+            raise SurfaceError('normal_browser_window_unavailable')
+        self.m.switch_to_window(matches[0], focus=False)
+        self.m.switch_to_frame()
+
+    def _dismiss_owned_panel(self):
+        self._chrome()
+        # A popup may destroy its browser during lock while Firefox leaves the
+        # owned panelview open. Close only this addon's exact main panelview.
+        return self.m.execute_script("""
+const p=document.getElementById('customizationui-widget-panel');
+const m=document.getElementById('customizationui-widget-multiview');
+const expected='PanelUI-webext-'+arguments[0].replace(/-browser-action$/,'-BAV');
+if(!p||!m||m.getAttribute('mainViewId')!==expected||p.state==='closed')return false;
+p.hidePopup();return true;
+""", script_args=[WIDGET_ID]) is True
+
+    def present(self):
+        self._chrome()
+        return self.m.execute_script(FIND, script_args=[ADDON_ID]) is not None
+
+    def open(self):
+        if not self.present():
+            if self._dismiss_owned_panel():
+                for _ in range(20):
+                    self._chrome()
+                    if self.m.execute_script("return document.getElementById('customizationui-widget-panel')?.state === 'closed';") is True:
+                        break
+                    time.sleep(0.05)
+            widget = self.m.find_element('id', WIDGET_ID)
+            buttons = widget.find_elements('css selector', '.unified-extensions-item-action-button')
+            (buttons[0] if len(buttons) == 1 else widget).click()
+        for _ in range(30):
+            if self.present():
+                return
+            time.sleep(0.1)
+        raise SurfaceError('popup_unavailable')
+
+    def execute(self, script, args=(), asynchronous=False):
+        self._chrome()
+        bridge = """
+const done=arguments[arguments.length-1],script=arguments[1],args=arguments[2];
+const p=WebExtensionPolicy.getByID(arguments[0]);
+if(!p){done({__surfaceError:true});return;}
+const prefix='moz-extension://'+p.mozExtensionHostname+'/popup/index.html';
+const matches=[...document.querySelectorAll('browser.webextension-popup-browser')]
+ .filter(b=>b.currentURI?.spec.split(/[?#]/)[0]===prefix&&b.closest('panel')?.state==='open'
