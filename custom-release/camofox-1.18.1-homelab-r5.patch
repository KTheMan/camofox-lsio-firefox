+++ b/tests/unit/humanControl.test.js
@@ -0,0 +1,150 @@
+import { describe, test, expect } from '@jest/globals';
+import {
+  assertAutomationAllowed, assertBrowserAutomationAllowed, assertNoOtherHumanControl,
+  detectHumanChallenge, handoffTtl, hasHumanControl, humanControlMiddleware,
+  humanControlState, isHumanControlProtected, markHumanControlFocused,
+  renewHumanControl, requestHumanControl, resumeHumanControl, sessionHasHumanControl,
+} from '../../lib/human-control.js';
+import { register } from '../../plugins/human-control/index.js';
+
+const makeSession = (tabState, tabId = 'tab-one') => ({ tabGroups: new Map([['task', new Map([[tabId, tabState]])]]) });
+const makeResponse = () => ({ statusCode: 200, status(n) { this.statusCode = n; return this; }, json(x) { this.body = x; return this; } });
+
+test('challenge inspection cannot strand handoff status on an unresponsive frame', async () => {
+  const page = { frames: () => [{ url: () => 'https://fixture.invalid/recaptcha/bframe', frameElement: () => new Promise(() => {}) }] };
+  await expect(detectHumanChallenge(page, 10)).resolves.toMatchObject({ verification: 'unknown', inspectionIncomplete: true });
+});
+
+describe('human-control ownership', () => {
+  test('pins human work beyond normal idle thresholds and resumes the same tab only after confirmation', () => {
+    const tab = { toolCalls: 3, page: {} };
+    const first = requestHumanControl(tab, { reason: 'captcha' }, 1000);
+    markHumanControlFocused(tab);
+    expect(sessionHasHumanControl(makeSession(tab), 601000)).toBe(true);
+    expect(isHumanControlProtected(tab, 601000)).toBe(true);
+    expect(() => assertAutomationAllowed(tab)).toThrow(/paused/);
+    expect(() => resumeHumanControl(tab, { leaseId: first.leaseId, humanConfirmed: false }, 601000)).toThrow(/explicitly confirms/);
+    const resumed = resumeHumanControl(tab, { leaseId: first.leaseId, humanConfirmed: true }, 601000);
+    expect(resumed.state).toBe('ready_to_resume');
+    expect(tab.toolCalls).toBe(3);
+    expect(tab._lastReaperCheck).toBe(601000);
+    expect(hasHumanControl(tab)).toBe(false);
+    expect(() => assertAutomationAllowed(tab)).not.toThrow();
+  });
+
+  test('retries preserve lease identity and do not extend lifetime silently', () => {
+    const tab = {};
+    const first = requestHumanControl(tab, {}, 1000);
+    expect(requestHumanControl(tab, { reason: 'login' }, 2000)).toEqual(first);
+    expect(() => renewHumanControl(tab, { leaseId: 'stale-lease' }, 3000)).toThrow(/changed/);
+    expect(renewHumanControl(tab, { leaseId: first.leaseId, ttlSeconds: 60 }, 3000).expiresAt).toBe(new Date(63000).toISOString());
+  });
+
+  test('expiry stops reaper protection but never silently starts automation', () => {
+    const tab = {};
+    const state = requestHumanControl(tab, { ttlSeconds: 30 }, 1000);
+    expect(humanControlState(tab, 31000).state).toBe('expired');
+    expect(isHumanControlProtected(tab, 31000)).toBe(false);
+    expect(hasHumanControl(tab)).toBe(true);
+    expect(() => assertAutomationAllowed(tab)).toThrow(/paused/);
+    renewHumanControl(tab, { leaseId: state.leaseId }, 32000);
+    expect(humanControlState(tab, 32000).state).toBe('needs_human');
+    expect(isHumanControlProtected(tab, 32000)).toBe(true);
+  });
+
+  test.each([0, 29, 1801, '900', Infinity, 30.5])('rejects unsafe TTL %s', (ttl) => {
+    expect(() => handoffTtl(ttl)).toThrow(/integer/);
+  });
+
+  test('the shared desktop cannot grant two tab owners or execute queued automation elsewhere', () => {
+    const first = {}, second = {};
+    requestHumanControl(first);
+    const sessions = new Map([['u', makeSession(first)]]);
+    expect(() => assertNoOtherHumanControl(sessions, second)).toThrow(/Another tab/);
+    expect(() => assertNoOtherHumanControl(sessions, first)).not.toThrow();
+    expect(() => assertBrowserAutomationAllowed(sessions)).toThrow(/paused/);
+  });
+});
+
+describe('human-control route boundary', () => {
+  const tab = {};
+  requestHumanControl(tab);
+  const gate = humanControlMiddleware(new Map([['u', makeSession(tab)]]));
+  test.each([
+    ['GET', '/tabs/tab-one/snapshot'], ['GET', '/TABS/tab-one/SCREENSHOT/'],
+    ['POST', '/tabs/tab-one/evaluate'], ['POST', '/navigate'], ['POST', '/act'],
+    ['GET', '/screenshot'], ['GET', '/snapshot/'], ['DELETE', '/sessions/u'],
+    ['POST', '/recaptcha/frame_eval'], ['POST', '/bitwarden/status'],
+    ['GET', '/future-plugin-capture'], ['DELETE', '/TABS/tab-one/HANDOFF/'],
+  ])('blocks %s %s while a human owns the desktop', (method, path) => {
+    let next = false;
+    const res = makeResponse();
+    gate({ method, path }, res, () => { next = true; });
+    expect(next).toBe(false);
+    expect(res.statusCode).toBe(409);
+    expect(res.body.code).toBe('human_control_active');
+  });
+
+  test.each([
+    ['GET', '/health'], ['GET', '/TABS/'], ['GET', '/tabs/tab-one/handoff'],
+    ['POST', '/TABS/tab-one/HANDOFF/renew/'], ['POST', '/tabs/tab-one/handoff/resume'],
+    ['POST', '/tabs/tab-one/focus'], ['POST', '/bitwarden/cancel'],
+    ['POST', '/bitwarden/lock'], ['GET', '/bitwarden/operations/one'],
+  ])('allows narrowly scoped management %s %s', (method, path) => {
+    let next = false;
+    gate({ method, path }, makeResponse(), () => { next = true; });
+    expect(next).toBe(true);
+  });
+});
+
+describe('challenge signals', () => {
+  test('keeps visible challenge separate from a persistent solved widget and never returns token values', async () => {
+    const token = 'dummy-token-never-return-this';
+    const page = {
+      frames: () => [{
+        url: () => 'https://fixture.invalid/recaptcha/api2/anchor',
+        frameElement: async () => ({ isVisible: async () => true, dispose: async () => {} }),
+        locator: () => ({ getAttribute: async () => 'true' }),
+      }],
+      evaluate: async () => Boolean(token),
+    };
+    const signal = await detectHumanChallenge(page);
+    expect(signal).toMatchObject({ detected: true, visibleChallenge: false, completionSignal: true, verification: 'completion_signal' });
+    expect(JSON.stringify(signal)).not.toContain(token);
+    expect(JSON.stringify(signal)).not.toContain('fixture.invalid');
+  });
+});
+
+describe('handoff route acquisition', () => {
+  function setup({ busy = false } = {}) {
+    const routes = new Map();
+    const page = { bringToFront: async () => {}, frames: () => [], evaluate: async () => false };
+    const tab = { page, toolCalls: 0 };
+    const ctx = {
+      sessions: new Map([['u', makeSession(tab)]]), normalizeUserId: (x) => x,
+      auth: () => (_req, _res, next) => next(), safeError: (e) => e.message,
+      withHumanControlLock: (_id, fn) => fn(), hasActiveBrowserRequests: () => busy,
+    };
+    const app = {
+      get: (path, ...handlers) => routes.set('GET ' + path, handlers.at(-1)),
+      post: (path, ...handlers) => routes.set('POST ' + path, handlers.at(-1)),
+    };
+    register(app, ctx);
+    return { tab, routes };
+  }
+  test('refuses acquisition while a snapshot or mutation is still in flight', async () => {
+    const { tab, routes } = setup({ busy: true });
+    const res = makeResponse();
+    await routes.get('POST /tabs/:tabId/handoff')({ body: { userId: 'u' }, params: { tabId: 'tab-one' } }, res);
+    expect(res.statusCode).toBe(409);
+    expect(res.body.code).toBe('browser_busy');
+    expect(tab.humanControl).toBeUndefined();
+  });
+  test('leases and focuses the original tab without creating another context', async () => {
+    const { tab, routes } = setup();
+    const res = makeResponse();
+    await routes.get('POST /tabs/:tabId/handoff')({ body: { userId: 'u', reason: 'captcha' }, params: { tabId: 'tab-one' } }, res);
+    expect(res.body).toMatchObject({ ok: true, tabId: 'tab-one', state: 'human_control' });
+    expect(hasHumanControl(tab)).toBe(true);
+  });
+});
