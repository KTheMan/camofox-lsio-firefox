@@ -0,0 +1,36 @@
+import importlib.util
+from pathlib import Path
+import unittest
+
+spec=importlib.util.spec_from_file_location('extension_surface',Path(__file__).with_name('extension_surface.py'))
+surface=importlib.util.module_from_spec(spec);spec.loader.exec_module(surface)
+
+class Windows:
+ def __init__(self,current,normal):self.current=current;self.normal=set(normal);self.selected=[];self.enumerations=0
+ def set_context(self,value):assert value=='chrome'
+ def switch_to_frame(self):pass
+ def execute_script(self,script,script_args=None):
+  if self.current=='discarded':raise RuntimeError('discarded window')
+  return self.current in self.normal
+ @property
+ def chrome_window_handles(self):self.enumerations+=1;return ['popout',*sorted(self.normal)]
+ def switch_to_window(self,handle,focus=True):assert focus is False;self.current=handle;self.selected.append(handle)
+
+class ChromeSelectionTests(unittest.TestCase):
+ def test_keeps_current_normal_window_without_enumerating(self):
+  m=Windows('main',{'main','other'});surface.ToolbarPopup(m)._chrome();self.assertEqual(m.current,'main');self.assertEqual(m.enumerations,0)
+ def test_falls_back_from_discarded_popout_to_single_normal_window(self):
+  m=Windows('discarded',{'main'});surface.ToolbarPopup(m)._chrome();self.assertEqual(m.current,'main');self.assertEqual(m.selected,['popout','main','main'])
+ def test_falls_back_when_initial_frame_reset_is_discarded(self):
+  class Discarded(Windows):
+   def switch_to_frame(self):
+    if self.current=='discarded':raise RuntimeError('discarded window')
+  m=Discarded('discarded',{'main'});surface.ToolbarPopup(m)._chrome();self.assertEqual(m.current,'main')
+ def test_rejects_ambiguous_fallback(self):
+  m=Windows('popout',{'main','other'})
+  with self.assertRaises(surface.SurfaceError):surface.ToolbarPopup(m)._chrome()
+ def test_rejects_missing_normal_window(self):
+  m=Windows('popout',set())
+  with self.assertRaises(surface.SurfaceError):surface.ToolbarPopup(m)._chrome()
+
+if __name__=='__main__':unittest.main()
