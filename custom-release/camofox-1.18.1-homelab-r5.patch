+"""Pinned Bitwarden 26.7 GET-only UI approval; caller owns session and addon pin.
+
+No SDK calls, vault reads, registration, secret entry, or retries after a click.
+Inspect results are private broker metadata; HTTP/MCP must expose typed states only.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import time
+from urllib.parse import parse_qs, urlsplit
+
+from approval_policy import ApprovalPolicy, PolicyError, is_blocked
+from extension_contract import parse_pending_popup
+
+ADDON_ID = '{446900e4-71c2-419f-a6a7-df9c091e268b}'
+ROW_SELECTOR = 'app-fido2-cipher-row button[bit-item-content]'
+AUTH_HEADING = 'Log in with passkey?'
+AUTH_SECTION = 'Choose a passkey to log in with'
+_DNS = re.compile(r'[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+\Z')
+
+INVENTORY_JS = r"""// CAMOFOX_PASSKEY_INVENTORY
+const visible=e=>{const r=e.getBoundingClientRect(),s=getComputedStyle(e);return r.width>0&&r.height>0&&s.display!=='none'&&s.visibility!=='hidden'};
+const roots=[...document.querySelectorAll('app-fido2')].filter(visible);
+const verification=[...document.querySelectorAll('input[type=password],app-two-factor-auth')].some(visible);
+if(roots.length!==1)return {rootCount:roots.length,verification};
+const root=roots[0],norm=s=>(s||'').replace(/\s+/g,' ').trim();
+const headings=[...root.querySelectorAll('popup-header h1')].filter(visible).map(e=>norm(e.textContent));
+// Angular projects the auth title's ng-container as direct section text nodes.
+const sectionTitles=[...root.querySelectorAll('bit-section > section')].map(s=>norm([...s.childNodes].filter(n=>n.nodeType===Node.TEXT_NODE).map(n=>n.textContent).join(' '))).filter(Boolean);
+const shellButtons=[...root.querySelectorAll('button')].filter(e=>visible(e)&&!e.closest('app-fido2-cipher-row')).map(e=>norm(e.textContent));
+const creation=!!root.querySelector('bit-search#search,input#search')||shellButtons.some(t=>['New','Save passkey','Save passkey as new login','Overwrite','Overwrite passkey','Replace','Yes'].includes(t));
+const nodes=[...root.querySelectorAll('app-fido2-cipher-row button[bit-item-content]')].filter(visible);
+if(nodes.length>64)return {rootCount:1,verification,overflow:true};
+return {rootCount:1,verification,headings,sectionTitles,creation,rows:nodes.map((b,index)=>({
+ index,name:norm(b.querySelector('[data-testid="item-name"]')?.textContent),
+ // Pinned ItemContentComponent projects the secondary divs into this wrapper.
+ secondary:[...b.querySelectorAll('[bittypography="helper"] > div')].map(e=>norm(e.textContent)),
+ disabled:b.disabled||b.getAttribute('aria-disabled')==='true'
+}))};
+"""
+
+TARGET_JS = "// CAMOFOX_PASSKEY_EXACT_TARGET\n" + r"""
+const observed=(function(){
+""" + INVENTORY_JS + r"""
+})();
+if(JSON.stringify(observed)!==JSON.stringify(arguments[0]))return {sent:false};
+const nodes=[...document.querySelectorAll('app-fido2-cipher-row button[bit-item-content]')].filter(e=>{const r=e.getBoundingClientRect(),s=getComputedStyle(e);return r.width>0&&r.height>0&&s.display!=='none'&&s.visibility!=='hidden'});
+const button=nodes[arguments[1]];
+if(!button||button.disabled||button.getAttribute('aria-disabled')==='true')return {sent:false};
+// The private native actor appends its lease deadline. Check inside this
+// exact DOM task as well, so a queued actor command cannot click after expiry.
+if(arguments[2]!==undefined&&(!Number.isSafeInteger(arguments[2])||Date.now()>=arguments[2]))return {sent:false};
+// Normal extension UI event; no internal Angular/SDK/message/crypto call.
+button.click();
+return {sent:true};
+"""
+
+NATIVE_SENDER_JS = r"""// CAMOFOX_PASSKEY_NATIVE_SENDER
+const {ExtensionParent}=ChromeUtils.importESModule('resource://gre/modules/ExtensionParent.sys.mjs');
+const p=WebExtensionPolicy.getByID(arguments[0]);
+if(!p||!p.active)return null;
+const t=ExtensionParent.apiManager.global.tabTracker.getTab(Number(arguments[1]),null);
+if(!t?.linkedBrowser)return null;
+const b=t.linkedBrowser;
+return {uuid:p.mozExtensionHostname,frameId:'mainframe-'+b.browsingContext.browserId,url:b.currentURI.spec};
+"""
+
+
+class SurfaceError(ValueError):
+    def __init__(self, code):
+        self.code = code
+        super().__init__(code)
+
+
+def _norm(value):
+    if not isinstance(value, str) or len(value) > 512 or any(ord(c) < 0x20 and c not in '\t\r\n' for c in value):
+        raise SurfaceError('invalid_prompt')
+    return ' '.join(value.split())
+
+
+def _origin(url):
+    try:
+        p = urlsplit(url)
+        if p.scheme != 'https' or not p.hostname or p.username is not None or p.password is not None or '\\' in url:
+            raise ValueError()
+        return 'https://' + p.netloc, p.hostname
+    except (ValueError, TypeError):
+        raise SurfaceError('invalid_binding')
+
+
+def _row_metadata(row, host, expected_rp=None):
+    if not isinstance(row, dict) or type(row.get('index')) is not int or type(row.get('disabled')) is not bool:
+        raise SurfaceError('invalid_prompt')
+    name = _norm(row.get('name'))
+    secondary = row.get('secondary')
+    if not isinstance(secondary, list) or len(secondary) > 2:
+        raise SurfaceError('invalid_prompt')
+    secondary = [_norm(s) for s in secondary]
+    def rp_ok(value):
+        return bool(len(value) <= 253 and _DNS.fullmatch(value) and (host == value or host.endswith('.' + value)))
+    candidates = []
+    # getSubName omits RP exactly when cipher.name == the first passkey's RP.
+    if rp_ok(name) and len(secondary) <= 1:
+        candidates.append((name, secondary[0] if secondary else ''))
+    if secondary and rp_ok(secondary[0]) and name != secondary[0]:
+        candidates.append((secondary[0], secondary[1] if len(secondary) == 2 else ''))
+    if len(candidates) != 1:
+        raise SurfaceError('ambiguous_credential')
+    rp, account = candidates[0]
+    if expected_rp is not None and rp != expected_rp:
+        raise SurfaceError('binding_mismatch')
+    return {'index': row['index'], 'name': name, 'rpId': rp, 'account': account, 'disabled': row['disabled']}
+
+
+def select_view(inv, binding, policy, account_hint=None):
+    """Pure GET-only selection. Unknown/ambiguous view metadata fails closed."""
+    if not isinstance(policy, ApprovalPolicy) or not isinstance(inv, dict):
+        raise SurfaceError('invalid_policy')
+    if inv.get('verification') is True:
+        raise SurfaceError('verification_required')
+    if (inv.get('rootCount') != 1 or inv.get('overflow') or inv.get('creation') is not False
+            or inv.get('headings') != [AUTH_HEADING]
+            or inv.get('sectionTitles') != [AUTH_SECTION]):
+        raise SurfaceError('not_get_prompt')
+    origin, host = _origin(binding.get('url'))
+    raw_rows = inv.get('rows')
+    if not isinstance(raw_rows, list) or not raw_rows or len(raw_rows) > 64:
+        raise SurfaceError('no_eligible_credential')
+    rows = [_row_metadata(r, host, binding.get('rpId')) for r in raw_rows]
+    if [r['index'] for r in rows] != list(range(len(rows))):
+        raise SurfaceError('invalid_prompt')
+    if policy.blocked_accounts and any(not r['account'] for r in rows):
+        raise SurfaceError('account_unavailable')
+    hint = None if account_hint is None else _norm(account_hint).casefold()
+    if hint == '':
+        raise SurfaceError('invalid_account_hint')
+    eligible = []
+    for row in rows:
+        observation = {'origin': origin, 'rpId': row['rpId']}
+        if row['account']:
+            observation['account'] = row['account']
+        if (not row['disabled'] and not is_blocked(policy, observation)
+                and (hint is None or row['account'].casefold() == hint)):
+            eligible.append(row)
+    if len(eligible) != 1:
+        raise SurfaceError('ambiguous_credential' if len(eligible) > 1 else 'no_eligible_credential')
+    selected = eligible[0]
+    content = {'heading': AUTH_HEADING, 'section': AUTH_SECTION, 'rows': rows, 'selected': selected}
+    fingerprint = hashlib.sha256(json.dumps(content, sort_keys=True, separators=(',', ':'), ensure_ascii=False).encode()).hexdigest()
+    return selected, fingerprint
+
+
+def _native_sender(m, sender):
+    m.set_context('chrome')
+    try:
+        return m.execute_script(NATIVE_SENDER_JS, script_args=[ADDON_ID, sender])
+    finally:
+        m.set_context('content')
+
+
+def _bound(m, url, binding, rp_id):
+    try:
+        sender = parse_qs(urlsplit(url).fragment.split('?', 1)[1]).get('senderTabId', [''])[0]
+        if not sender.isdecimal() or not sender:
+            raise ValueError()
+        actual = _native_sender(m, sender)
+        if not actual or actual.get('uuid') != binding.get('extensionUuid') or actual.get('url') != binding.get('url'):
+            raise ValueError()
+        parsed = parse_pending_popup(url, binding['extensionUuid'], binding['url'], rp_id,
+                                     binding['frameId'], actual.get('frameId'))
+        if binding.get('sessionId') is not None and parsed['sessionId'] != binding['sessionId']:
+            raise ValueError()
+        return parsed
+    except (KeyError, ValueError, TypeError, IndexError):
+        raise SurfaceError('binding_mismatch')
+
+
+def _popup_url(m, handle, observed, provenance):
+    # Only the private prearmed native observer may resolve the demonstrated
+    # same-document vendor route rewrite. No model-supplied URL is accepted.
+    if provenance is None:
+        return observed
+    try:
+        resolved = provenance.initial_url(handle, observed)
+        if not isinstance(resolved, str) or not resolved:
+            raise ValueError()
+        return resolved
+    except Exception:
+        raise SurfaceError('binding_mismatch') from None
+
+
+def _inspect(m, binding, policy, account_hint, provenance=None):
+    if not isinstance(binding, dict) or not {'url', 'frameId', 'extensionUuid'}.issubset(binding):
+        raise SurfaceError('invalid_binding')
+    matches = []
+    m.set_context('content')
+    for handle in list(m.window_handles):
+        qualified = False
+        try:
+            m.switch_to_window(handle, focus=False)
+            url = m.get_url()
+            u = urlsplit(url)
+            if (u.scheme != 'moz-extension' or u.netloc != binding['extensionUuid'] or u.path != '/popup/index.html'
+                    or 'singleActionPopout=' not in u.query):
+                continue
+            qualified = True
+            url = _popup_url(m, handle, url, provenance)
+            inv = m.execute_script(INVENTORY_JS)
+            selected, fingerprint = select_view(inv, binding, policy, account_hint)
+            parsed = _bound(m, url, binding, selected['rpId'])
+            matches.append((handle, url, selected, fingerprint, parsed))
+        except (SurfaceError, PolicyError) as exc:
+            # A visible FIDO2 prompt for this addon must never silently become
+            # another candidate after a binding/policy/ceremony refusal.
+            raise SurfaceError(getattr(exc, 'code', 'policy_refused')) from None
