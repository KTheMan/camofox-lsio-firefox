@@ -0,0 +1,86 @@
+import { createPublicKey, verify } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+import http from 'node:http';
+
+const forbidden = () => Object.assign(new Error('Access assertion rejected'), { statusCode: 403 });
+function decode(segment) {
+  if (!/^[A-Za-z0-9_-]+$/.test(segment)) throw forbidden();
+  const buffer = Buffer.from(segment, 'base64url');
+  if (buffer.toString('base64url') !== segment) throw forbidden();
+  return buffer;
+}
+
+export function createAccessVerifier({ issuer, audience, jwksFile, fetchImpl = fetch, now = Date.now }) {
+  const origin = new URL(issuer);
+  if (origin.protocol !== 'https:' || origin.origin !== issuer || origin.username || origin.password || !audience) {
+    throw new Error('Access requires an exact HTTPS issuer origin and application audience');
+  }
+  let keys = new Map();
+  let loadedAt = -Infinity;
+  let loading;
+  async function refresh() {
+    if (loading) return loading;
+    loading = (async () => {
+      let set;
+      if (jwksFile) set = JSON.parse(await readFile(jwksFile, 'utf8'));
+      else {
+        const response = await fetchImpl(`${issuer}/cdn-cgi/access/certs`, {
+          redirect: 'error', signal: AbortSignal.timeout(5000),
+        });
+        if (!response.ok) throw new Error('Access signing keys unavailable');
+        set = await response.json();
+      }
+      if (!Array.isArray(set.keys) || set.keys.length > 20) throw new Error('Invalid Access signing keys');
+      const next = new Map();
+      for (const key of set.keys) {
+        if (key.kty !== 'RSA' || typeof key.kid !== 'string' || key.kid.length > 128 || (key.alg && key.alg !== 'RS256') || (key.use && key.use !== 'sig')) continue;
+        if (next.has(key.kid)) throw new Error('Ambiguous Access signing key');
+        next.set(key.kid, createPublicKey({ key, format: 'jwk' }));
+      }
+      if (!next.size) throw new Error('No Access signing keys');
+      keys = next;
+      loadedAt = now();
+    })();
+    try { await loading; } finally { loading = undefined; }
+  }
+  return async function verifyAssertion(token) {
+    if (typeof token !== 'string' || token.length > 16000) throw forbidden();
+    const segments = token.split('.');
+    if (segments.length !== 3) throw forbidden();
+    let header, claims;
+    try { header = JSON.parse(decode(segments[0])); claims = JSON.parse(decode(segments[1])); } catch { throw forbidden(); }
+    if (header?.alg !== 'RS256' || typeof header.kid !== 'string' || header.kid.length > 128 || header.crit || header.jku || header.jwk || header.x5u) throw forbidden();
+    const seconds = Math.floor(now() / 1000);
+    const aud = Array.isArray(claims?.aud) ? claims.aud : [claims?.aud];
+    if (claims?.iss !== issuer || !aud.includes(audience) || !Number.isInteger(claims.exp) || claims.exp <= seconds
+      || (claims.nbf !== undefined && (!Number.isInteger(claims.nbf) || claims.nbf > seconds))
+      || (claims.iat !== undefined && (!Number.isInteger(claims.iat) || claims.iat > seconds + 30))) throw forbidden();
+    // Coalesce refresh and rate-limit unknown-kid refreshes to avoid a peer
+    // turning verification into a request-per-token to the trusted issuer.
+    if (now() - loadedAt > 10 * 60_000 || (!keys.has(header.kid) && now() - loadedAt >= 60_000)) await refresh();
+    const key = keys.get(header.kid);
+    if (!key) throw forbidden();
+    let signature;
+    try { signature = decode(segments[2]); } catch { throw forbidden(); }
+    if (!verify('RSA-SHA256', Buffer.from(`${segments[0]}.${segments[1]}`), key, signature)) throw forbidden();
+    return true;
+  };
+}
+
+export function startAccessGate(config) {
+  const verifyAssertion = createAccessVerifier(config);
+  const server = http.createServer({ maxHeaderSize: 20_000 }, async (req, res) => {
+    res.setHeader('Cache-Control', 'no-store');
+    if (!['GET', 'HEAD'].includes(req.method) || req.url !== '/verify') { res.writeHead(404).end(); return; }
+    try {
+      await verifyAssertion(req.headers['cf-access-jwt-assertion']);
+      res.writeHead(204).end();
+    } catch (error) {
+      res.writeHead(error.statusCode === 403 ? 403 : 503).end();
+    }
+  });
+  server.headersTimeout = 10_000;
+  server.requestTimeout = 10_000;
+  server.listen(config.port, config.host);
+  return server;
+}
