+/** One fixed native controller per unlocked lease; no late permits after timeout/close. */
+import {spawn} from 'node:child_process';import crypto from 'node:crypto';import {fileURLToPath} from 'node:url';
+const SCRIPT=fileURLToPath(new URL('./passkey-driver.py',import.meta.url));
