+        # task. No page event can reorder/replace a row between those steps.
+        sent = True  # A thrown command may already have clicked: never retry.
+        if provenance is None:
+            delivery = m.execute_script(TARGET_JS, script_args=[final_inv, selected['index']])
+        else:
+            # Pin the final DOM task to the exact captured WindowGlobal actor.
+            # A replacement document must never inherit an old session permit.
+            delivery = provenance.execute_target(handle, m.get_url(), url, TARGET_JS,
