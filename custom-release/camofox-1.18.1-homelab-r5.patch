diff --git a/tests/unit/evaluateTimeoutRecovery.test.js b/tests/unit/evaluateTimeoutRecovery.test.js
new file mode 100644
index 0000000..5f9c21d
--- /dev/null
+++ b/tests/unit/evaluateTimeoutRecovery.test.js
@@ -0,0 +1,60 @@
+import { describe, test, expect } from '@jest/globals';
+import { assertAutomationAllowed, requestHumanControl } from '../../lib/human-control.js';
+import { preserveEvaluationForHumanRecovery } from '../../lib/evaluate-timeout-recovery.js';
+
+function captureError(fn) {
+  try { fn(); } catch (error) { return error; }
+  throw new Error('expected function to throw');
+}
+
+describe('evaluate timeout recovery lease', () => {
+  test('creates a manual lease and blocks queued automation on the same owned tab', () => {
+    const tab = { page: { close: () => { throw new Error('must not close'); } } };
+    let error;
+    try {
+      preserveEvaluationForHumanRecovery(tab, { tabStillOwned: true });
+    } catch (caught) {
+      error = caught;
+    }
+    expect(error).toMatchObject({ statusCode: 409, code: 'recovery_handoff_required' });
+    expect(error.message).toBe('Evaluation outcome is unknown; original tab preserved for human recovery.');
+    expect(error.message).not.toMatch(/timeout|timed out|expression|url/i);
+    expect(tab.humanControl).toMatchObject({ reason: 'manual', state: 'needs_human' });
+    expect(() => assertAutomationAllowed(tab)).toThrow(/paused for human control/);
+  });
+
+  test('preserves an existing lease object, id, reason, and pause state', () => {
+    const tab = {};
+    requestHumanControl(tab, { reason: 'captcha' });
+    const lease = tab.humanControl;
+    expect(captureError(() => preserveEvaluationForHumanRecovery(tab, { tabStillOwned: true })))
+      .toMatchObject({ code: 'recovery_handoff_required', statusCode: 409 });
+    expect(tab.humanControl).toBe(lease);
+    expect(tab.humanControl).toMatchObject({ leaseId: lease.leaseId, reason: 'captcha', state: 'needs_human' });
+  });
+
+  test('creates a fresh manual lease after an earlier lease reached ready-to-resume', () => {
+    const tab = {};
+    requestHumanControl(tab, { reason: 'login' });
+    const previous = tab.humanControl;
+    previous.state = 'ready_to_resume';
+    expect(captureError(() => preserveEvaluationForHumanRecovery(tab, { tabStillOwned: true })))
+      .toMatchObject({ code: 'recovery_handoff_required' });
+    expect(tab.humanControl).not.toBe(previous);
+    expect(tab.humanControl.leaseId).not.toBe(previous.leaseId);
+    expect(tab.humanControl).toMatchObject({ reason: 'manual', state: 'needs_human' });
+    expect(tab.humanControl.expiresAt).toBeGreaterThan(Date.now());
+    expect(tab.humanControl.expiresAt).toBeLessThanOrEqual(Date.now() + 15 * 60 * 1000);
+    expect(() => assertAutomationAllowed(tab)).toThrow(/paused for human control/);
+  });
+
+  test.each([
+    ['tab ownership changed', { tabStillOwned: false }],
+    ['another owner is protected', { tabStillOwned: true, protectedElsewhere: true }],
+  ])('does not create a lease when %s', (_label, options) => {
+    const tab = {};
+    expect(captureError(() => preserveEvaluationForHumanRecovery(tab, options)))
+      .toMatchObject({ statusCode: 409, code: 'human_control_active' });
+    expect(tab.humanControl).toBeUndefined();
+  });
+});
diff --git a/tests/unit/humanControl.test.js b/tests/unit/humanControl.test.js
