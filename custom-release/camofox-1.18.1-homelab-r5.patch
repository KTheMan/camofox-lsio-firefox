+        initial = "moz-extension://" + EXT + "/popup/index.html?uilocation=popout&singleActionPopout=vault_Fido2Popout_8f1f3b7d-61ec-4e64-a4a1-2dab403f00df#/fido2?sessionId=8f1f3b7d-61ec-4e64-a4a1-2dab403f00df"
