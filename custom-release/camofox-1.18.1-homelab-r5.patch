+import { accessKeyMiddleware } from '../../lib/auth.js';
+
+function run(config, path, method = 'GET', token) {
+  let next = false, status;
+  const res = { status(n) { status = n; return this; }, set() { return this; }, json() { return this; } };
+  accessKeyMiddleware(config)({ path, method, headers: token ? { authorization: `Bearer ${token}` } : {} }, res, () => { next = true; });
+  return { next, status };
+}
+test.each(['/tabs', '/TABS/', '/snapshot', '/act', '/sessions/selkies', '/recaptcha/frames', '/auth-sessions/future'])('API-only deployments protect %s', path => {
+  expect(run({ apiKey: 'owner' }, path, 'POST')).toEqual({ next: false, status: 401 });
+  expect(run({ apiKey: 'owner' }, path, 'POST', 'owner').next).toBe(true);
+});
+test.each(['/health', '/HEALTH/'])('health checks stay available at %s', path => {
+  expect(run({ apiKey: 'owner' }, path).next).toBe(true);
+  expect(run({ apiKey: 'owner' }, path, 'POST').status).toBe(401);
+});
+test('dedicated keys retain precedence and stale auth-session prefix has no exemption', () => {
+  const config = { apiKey: 'api', accessKey: 'control', adminKey: 'admin' };
+  expect(run(config, '/tabs', 'POST', 'api').status).toBe(401);
+  expect(run(config, '/tabs', 'POST', 'control').next).toBe(true);
+  expect(run(config, '/sessions/user/cookies/', 'POST').next).toBe(true);
+  expect(run(config, '/STOP/', 'POST').next).toBe(true);
+  expect(run(config, '/auth-sessions/future', 'GET', 'api').status).toBe(401);
+});
diff --git a/tests/unit/bitwardenBroker.test.js b/tests/unit/bitwardenBroker.test.js
new file mode 100644
index 0000000..b1afe7e
--- /dev/null
+++ b/tests/unit/bitwardenBroker.test.js
@@ -0,0 +1,192 @@
+import { describe, test, expect, jest } from '@jest/globals';
+import { createBitwardenBroker, sanitizeDriverResult, runDriver } from '../../plugins/bitwarden-unlock/runtime.js';
+import { EventEmitter } from 'node:events';
+
+function harness(options = {}) {
+  const driver = jest.fn(async (request) => ({ ok: true, state: request.action === 'lock' ? 'locked' : 'unlocked' }));
+  const onHumanControl = jest.fn(), clearHumanControl = jest.fn();
+  const broker = createBitwardenBroker({ ensureBrowser: async () => {}, driver, onHumanControl, clearHumanControl, isBrowserBusy: () => false, ...options });
+  return { broker, driver, onHumanControl, clearHumanControl };
+}
+const delivery = (op) => ({ operationId: op.operationId, browserInstance: op.browserInstance, email: 'dummy@example.invalid', masterPassword: 'dummy-only-password' });
+
+describe('Bitwarden protected broker', () => {
+  test('opaque HTTP-facing operation is browser-bound and does not expose credentials', async () => {
+    const { broker } = harness();
+    const op = await broker.requestUnlock('owner');
+    expect(op).toMatchObject({ scope: 'browser', state: 'awaiting_secret' });
+    expect(JSON.stringify(op)).not.toMatch(/masterPassword|dummy-only|email/);
+    expect(() => broker.operation('other', op.operationId)).toThrow('operation_not_found');
+    await expect(broker.requestUnlock('other')).rejects.toThrow('browser_vault_busy');
+    await expect(broker.deliver({ ...delivery(op), browserInstance: 'wrong-browser' })).rejects.toThrow('operation_unavailable');
+    await broker.close();
+  });
+  test('control is acquired before private fill and released only after typed success', async () => {
+    const calls = [];
+    const { broker } = harness({
+      onHumanControl: (lease) => calls.push(['control', lease.reason]),
+      clearHumanControl: () => calls.push(['clear']),
+      driver: async (request) => { calls.push(['driver', request.action]); return { ok: true, state: 'unlocked', inventory: 'must not escape' }; },
+    });
+    const op = await broker.requestUnlock('owner'), envelope = delivery(op);
+    const result = await broker.deliver(envelope);
+    expect(result.state).toBe('unlocked');
+    expect(envelope.masterPassword).toBeUndefined();
+    expect(calls).toEqual([['control', 'bitwarden_unlock'], ['driver', 'unlock'], ['clear']]);
+    expect(JSON.stringify(result)).not.toMatch(/dummy-only|inventory/);
+    await broker.close();
+  });
+  test('busy browser refuses secret delivery without retaining envelope or running driver', async () => {
+    const { broker, driver } = harness({ isBrowserBusy: () => true });
+    const op = await broker.requestUnlock('owner'), envelope = delivery(op);
+    await expect(broker.deliver(envelope)).rejects.toThrow('browser_busy');
+    expect(envelope.masterPassword).toBeUndefined();
+    expect(driver).not.toHaveBeenCalled();
+    await broker.close();
+  });
+  test('browser restart invalidates old operation and prevents credential delivery', async () => {
+    const { broker, driver } = harness();
+    const op = await broker.requestUnlock('owner');
+    broker.browserChanged();
+    await expect(broker.deliver(delivery(op))).rejects.toThrow('operation_unavailable');
+    expect(broker.operation('owner', op.operationId).state).toBe('cancelled');
+    expect(driver).not.toHaveBeenCalled();
+    await broker.close();
+  });
+  test('a concurrent human reservation refuses delivery without stranding unlocking state', async () => {
+    const { broker, driver } = harness({ onHumanControl: () => { throw new Error('already controlled'); } });
+    const op = await broker.requestUnlock('owner'), envelope = delivery(op);
+    await expect(broker.deliver(envelope)).rejects.toThrow('browser_busy');
+    expect(driver).not.toHaveBeenCalled();
+    expect(envelope.masterPassword).toBeUndefined();
+    expect(broker.operation('owner', op.operationId).state).toBe('awaiting_secret');
+    await broker.close();
+  });
+  test('expired delivery is never attempted and TTL has bounded validation', async () => {
+    let clock = 100000;
+    const { broker, driver } = harness({ now: () => clock });
+    await expect(broker.requestUnlock('owner', 29)).rejects.toThrow('invalid_ttl');
+    await expect(broker.requestUnlock('owner', 901)).rejects.toThrow('invalid_ttl');
+    const op = await broker.requestUnlock('owner'); clock += 60001;
+    await expect(broker.deliver(delivery(op))).rejects.toThrow('operation_unavailable');
+    expect(broker.operation('owner', op.operationId).state).toBe('expired');
+    expect(driver).not.toHaveBeenCalled();
+    await broker.close();
+  });
+  test('protected preflight can verify readiness without a secret or driver execution', async () => {
+    const { broker, driver } = harness();
+    const op = await broker.requestUnlock('owner');
+    expect((await broker.deliver({ action: 'check', operationId: op.operationId, browserInstance: op.browserInstance })).state).toBe('awaiting_secret');
+    expect(driver).not.toHaveBeenCalled();
+    await expect(broker.deliver({ action: 'check', operationId: op.operationId, browserInstance: 'different' })).rejects.toThrow('operation_unavailable');
+    await broker.close();
+  });
+  test('cancel waits for in-flight authentication before relocking', async () => {
+    let complete;
+    const calls = [];
+    const { broker } = harness({ driver: async (request) => {
+      calls.push(request.action);
+      if (request.action === 'unlock') return new Promise((resolve) => { complete = resolve; });
+      return { ok: true, state: 'locked' };
+    } });
+    const op = await broker.requestUnlock('owner');
+    const inFlight = broker.deliver(delivery(op));
+    await Promise.resolve();
+    const cancelled = broker.cancel('owner', op.operationId);
+    expect(calls).toEqual(['unlock']);
+    await expect(broker.requestUnlock('owner')).rejects.toThrow('browser_vault_busy');
+    complete({ ok: true, state: 'unlocked' });
+    await inFlight;
+    expect((await cancelled).state).toBe('cancelled');
+    expect(calls).toEqual(['unlock', 'lock']);
+    await broker.close();
+  });
+  test('2FA preserves human control; polling completion releases it', async () => {
+    let authenticated = false;
+    const statusDriver = jest.fn(async (request) => {
+      if (request.action === 'unlock') return { ok: false, state: 'two_factor_required', errorCode: 'two_factor_required' };
+      return { ok: true, state: authenticated ? 'unlocked' : 'two_factor_required' };
+    });
+    const { broker, onHumanControl, clearHumanControl } = harness({ driver: statusDriver });
+    const op = await broker.requestUnlock('owner');
+    expect((await broker.deliver(delivery(op))).state).toBe('two_factor_required');
+    expect(onHumanControl).toHaveBeenLastCalledWith(expect.objectContaining({ reason: 'bitwarden_two_factor' }));
+    expect(clearHumanControl).not.toHaveBeenCalled();
+    authenticated = true;
+    await broker.status('owner');
+    expect(statusDriver).toHaveBeenNthCalledWith(2,
+      { action: 'status', expectedServerOrigin: 'https://vault.example.invalid' },
+      { keepHumanUI: true });
+    expect(broker.operation('owner', op.operationId).state).toBe('unlocked');
+    expect(clearHumanControl).toHaveBeenCalledWith(op.operationId);
+    await broker.close();
+  });
+  test('2FA status driver failure keeps the human reservation active', async () => {
+    const driver = jest.fn(async (request) => request.action === 'unlock'
+      ? { ok: false, state: 'two_factor_required', errorCode: 'two_factor_required' }
+      : { ok: false, state: 'unavailable', errorCode: 'driver_timeout' });
+    const { broker, clearHumanControl } = harness({ driver });
+    const op = await broker.requestUnlock('owner');
+    expect((await broker.deliver(delivery(op))).state).toBe('two_factor_required');
+    const status = await broker.status('owner');
+    expect(status).toMatchObject({ ok: false, state: 'unavailable', errorCode: 'driver_timeout' });
+    expect(broker.operation('owner', op.operationId).state).toBe('two_factor_required');
+    expect(clearHumanControl).not.toHaveBeenCalled();
+    await expect(broker.requestUnlock('owner')).rejects.toThrow('browser_vault_busy');
+    await broker.close();
+  });
+  test('timeout or uncertain driver failure stays blocked until confirmed lock', async () => {
+    let lockWorks = false;
+    const { broker, onHumanControl, clearHumanControl } = harness({ driver: async (request) => request.action === 'lock' && lockWorks ? { ok: true, state: 'locked' } : { ok: false, state: 'unavailable', errorCode: 'driver_timeout' } });
+    const op = await broker.requestUnlock('owner');
+    expect((await broker.deliver(delivery(op))).state).toBe('lock_failed');
+    expect(onHumanControl).toHaveBeenLastCalledWith(expect.objectContaining({ reason: 'bitwarden_lock_failed', expiresAt: Number.MAX_SAFE_INTEGER }));
+    await expect(broker.requestUnlock('owner')).rejects.toThrow('lock_required');
+    expect(clearHumanControl).not.toHaveBeenCalled();
+    lockWorks = true;
+    expect((await broker.lock('owner')).state).toBe('locked');
+    expect(clearHumanControl).toHaveBeenCalledWith(op.operationId);
+    await broker.close();
+  });
+  test('driver output is allowlisted and exception text cannot leak', () => {
+    expect(sanitizeDriverResult({ ok: false, state: 'locked', errorCode: 'secret exception', inventory: 'private', bodyText: 'private' })).toEqual({ ok: false, state: 'locked' });
+    expect(sanitizeDriverResult({ state: 'secret-as-state' })).toEqual({ ok: false, state: 'unavailable', errorCode: 'driver_failed' });
+  });
+  test('new unlock cannot race a browser-wide lock already in progress', async () => {
+    let finishLock;
+    const { broker } = harness({ driver: async () => new Promise((resolve) => { finishLock = resolve; }) });
+    const locking = broker.lock('owner');
+    await Promise.resolve(); await Promise.resolve();
+    await expect(broker.requestUnlock('owner')).rejects.toThrow('browser_vault_busy');
+    finishLock({ ok: true, state: 'locked' });
+    expect((await locking).ok).toBe(true);
+    await broker.close();
+  });
+  test('unlock lifetime expiry verifies relock, and failed relock stays blocked', async () => {
+    let expire;
+    const { broker, driver, onHumanControl } = harness({
+      schedule: (callback) => { expire = callback; return { unref() {} }; },
+      driver: async (request) => request.action === 'unlock' ? { ok: true, state: 'unlocked' } : { ok: false, state: 'lock_failed', errorCode: 'lock_failed' },
+    });
+    const op = await broker.requestUnlock('owner'); await broker.deliver(delivery(op));
+    expire(); await Promise.resolve(); await Promise.resolve(); await Promise.resolve();
+    expect(broker.operation('owner', op.operationId).state).toBe('lock_failed');
+    expect(onHumanControl).toHaveBeenLastCalledWith(expect.objectContaining({ reason: 'bitwarden_lock_failed' }));
+    await expect(broker.requestUnlock('owner')).rejects.toThrow('lock_required');
+    await broker.close();
+  });
+  test('subprocess receives secret only on stdin and discards stderr', async () => {
+    let invocation, stdin;
+    const spawnDriver = (program, args, options) => {
+      invocation = { program, args, options };
+      const child = new EventEmitter(); child.stdout = new EventEmitter(); child.stdin = new EventEmitter(); child.kill = jest.fn();
+      child.stdin.end = (value) => { stdin = value; queueMicrotask(() => { child.stdout.emit('data', Buffer.from('{"ok":true,"state":"locked","inventory":"private"}')); child.emit('close', 0); }); };
+      return child;
+    };
+    expect(await runDriver({ action: 'unlock', masterPassword: 'dummy-only-password' }, { spawnDriver })).toEqual({ ok: true, state: 'locked' });
+    expect(invocation.args).toHaveLength(1);
+    expect(JSON.stringify(invocation)).not.toContain('dummy-only-password');
+    expect(invocation.options.stdio).toEqual(['pipe', 'pipe', 'ignore']);
+    expect(JSON.parse(stdin).masterPassword).toBe('dummy-only-password');
+  });
+});
