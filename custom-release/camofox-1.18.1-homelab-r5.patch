+import { readFileSync, writeFileSync, mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { loadMcpConfig } from '../../mcp/lib/config.mjs';
+import { loadConfig } from '../../lib/config.js';
+
+test('server and standalone MCP consume the same protected key-file contract', () => {
+  const dir = mkdtempSync(join(tmpdir(), 'camofox-key-fixture-'));
+  const key = join(dir, 'key');
+  const old = process.env.CAMOFOX_API_KEY_FILE;
+  try {
+    writeFileSync(key, 'dummy-control-key\n', { mode: 0o600 });
+    process.env.CAMOFOX_API_KEY_FILE = key;
