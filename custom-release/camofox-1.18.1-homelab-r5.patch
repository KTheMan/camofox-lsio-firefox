--- /dev/null
+++ b/tests/unit/snapshotStructurePrivacy.test.js
@@ -0,0 +1,28 @@
+import { extractPageStructure } from '../../lib/page-structure.js';
+
+// Firefox can return an empty autocomplete property for a valid raw token.
+const makeInput = attrs => ({ tagName: 'INPUT', type: attrs.type || 'text', id: attrs.id || 'verification', name: attrs.name || 'code', autocomplete: '', value: 'DUMMY-SECRET-123456', disabled: false,
+  getAttribute: key => attrs[key] ?? null, closest: () => null });
+test.each([
+  { type: 'password' }, { autocomplete: 'one-time-code' }, { 'aria-label': 'Password' },
+  { 'aria-label': 'API key' }, { name: 'cvc' }, { name: 'otp' }, { id: 'pin' },
+  { tag: 'SELECT', name: 'api_key', type: 'select-one' },
+])('structured output omits sensitive control values: %j', async attrs => {
+  const input = makeInput(attrs);
+  if (attrs.tag === 'SELECT') {
+    input.tagName = 'SELECT';
+    input.options = [{ textContent: 'DUMMY-OPTION-LABEL', value: 'DUMMY-OPTION-KEY', selected: true }];
+  }
+  const form = { id: 'login', name: '', getAttribute: () => null, closest: () => null,
+    querySelectorAll: selector => selector === 'input, select, textarea' ? [input] : [] };
+  const saved = { document: global.document, CSS: global.CSS };
+  global.CSS = { escape: value => value };
+  global.document = { forms: [form], querySelectorAll: () => [], querySelector: () => null, getElementById: () => null };
+  try {
+    const result = await extractPageStructure({ isClosed: () => false, evaluate: (fn, arg) => fn(arg) });
+    expect(result.forms[0].fields[0]).not.toHaveProperty('value');
+    expect(JSON.stringify(result)).not.toContain(input.value);
+    expect(JSON.stringify(result)).not.toContain('DUMMY-OPTION');
+    expect(input.value).toBe('DUMMY-SECRET-123456');
+  } finally { global.document = saved.document; global.CSS = saved.CSS; }
+});
