+            with self.subTest(value=value), self.assertRaises(ValueError):
+                PopupProvenance(FakeMarionette(), EXT, value)
+        with patch.object(popup_provenance.time, "time", return_value=1234.0):
+            with self.assertRaises(ValueError):
+                PopupProvenance(FakeMarionette(), EXT, 1_234_000 + 900_001)
+        with self.assertRaises(ValueError):
+            PopupProvenance(FakeMarionette(), "{" + EXT + "}", deadline())
+
+    def test_arms_once_resolves_and_restores_content_context(self):
+        m = FakeMarionette()
+        p = PopupProvenance(m, EXT, deadline())
+        self.assertTrue(p.arm())
+        with self.assertRaises(ValueError):
+            p.arm()
+        expected = p.initial_url("popup", "moz-extension://observed")
+        self.assertTrue(expected.startswith("moz-extension://" + EXT + "/popup/index.html?"))
+        self.assertEqual(m.context, "content")
+        self.assertEqual(m.current_handle, "popup")
+        self.assertGreaterEqual(m.calls.count(("reset_frame", "popup")), 2)
+
+    def test_final_action_uses_only_pinned_target_script_and_same_actor_bridge(self):
