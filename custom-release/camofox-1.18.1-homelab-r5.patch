+   *     requestBody:
+   *       required: true
+   *       content:
+   *         application/json:
+   *           schema:
+   *             type: object
+   *             required: [userId]
+   *             properties:
+   *               userId: { type: string }
+   *     responses:
+   *       200: { description: Typed extension state. }
+   *       503: { description: Extension or broker unavailable. }
+   */
+  app.post('/bitwarden/status', ctx.auth(), route(async (req, res) => {
+    const result = await broker.status(userId(body(req).userId));
+    return res.status(result.ok ? 200 : 503).json(result);
+  }));
+  /**
+   * @openapi
+   * /bitwarden/unlock:
+   *   post:
+   *     tags: [Browser]
+   *     summary: Request opaque unlock; credentials must arrive through the local broker socket.
+   *     requestBody:
+   *       required: true
+   *       content:
+   *         application/json:
+   *           schema:
+   *             type: object
+   *             additionalProperties: false
+   *             required: [userId]
+   *             properties:
+   *               userId: { type: string }
+   *               ttlSeconds: { type: integer, minimum: 30, maximum: 900, default: 300 }
+   *     responses:
+   *       202: { description: Awaiting protected local credential delivery. }
+   *       409: { description: Another browser-wide operation owns the extension. }
+   */
