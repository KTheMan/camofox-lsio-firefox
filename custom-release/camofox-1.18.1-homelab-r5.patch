+  const out={ok:v.ok,state:v.state};const code=ALIASES[v.errorCode]||v.errorCode;if(ERRORS.has(code))out.errorCode=code;
+  finish(c,out);
+ };
+ const start=signal=>{
+  let closeResolve;const c={child:null,signal,closing:false,closedSeen:false,current:null,tail:Promise.resolve(),buffer:'',bytes:0,closed:new Promise(r=>closeResolve=r)};
+  c.closeResolve=closeResolve;
